<UserControl
    x:Class="Pivot.CodeModule.Controls.QuickAddControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pivot.CodeModule.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="16">

        <!-- Collapsed State: Use a clickable placeholder instead of TextBox to avoid focus issues -->
        <Border x:Name="CollapsedPlaceholder"
                Background="Transparent"
                PointerPressed="CollapsedPlaceholder_PointerPressed"
                Padding="0,8">
            <TextBlock Text="新しいコードを追加..."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False"/>
        </Border>

        <!-- Expanded State -->
        <Grid x:Name="ExpandedPanel" 
              Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,12">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBox x:Name="TitleBox"
                     Grid.Row="0"
                     Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="タイトル (任意)"
                     BorderThickness="0"
                     Background="Transparent"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>

            <!-- Language Selector + Code Editor -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="CodeEditor"
                         Grid.Row="0"
                         Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="コードを入力..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         MinHeight="120"
                         MaxHeight="400"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Tags Section (Google Keep style) -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Existing Tags (Toggle Chips) -->
                <ItemsRepeater x:Name="ExistingTagsRepeater" Grid.Row="0" Margin="0,0,0,8">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <ToggleButton Content="{x:Bind}" 
                                      Checked="TagToggle_Checked"
                                      Unchecked="TagToggle_Unchecked"
                                      Padding="8,4" 
                                      CornerRadius="12"
                                      FontSize="12"
                                      MinHeight="28"
                                      MinWidth="0"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- New Tag Input -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewTagBox"
                             Text="{x:Bind ViewModel.NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="+ 新しいタグ"
                             Width="150"
                             Height="28"
                             Padding="8,2"
                             FontSize="12"
                             BorderThickness="1"
                             CornerRadius="12"
                             KeyDown="NewTagBox_KeyDown"/>
                    <Button x:Name="AddTagButton" 
                            Content="追加"
                            Height="28"
                            Padding="12,2"
                            FontSize="12"
                            CornerRadius="12"
                            Click="AddTagButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton"
                        Content="キャンセル"
                        Click="CancelButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"/>
                <Button x:Name="SaveButton"
                        Content="保存"
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
