<UserControl
    x:Class="Pivot.CodeModule.Controls.OverlayEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pivot.CodeModule.ViewModels"
    xmlns:converters="using:Pivot.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:CodeEditorViewModel}">

    <UserControl.Resources>
        <converters:TagSelectionConverter x:Key="TagSelectionConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Dimmed Background -->
        <Border Background="#80000000" 
                PointerPressed="Background_PointerPressed"/>

        <!-- Editor Card -->
        <Grid HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch"
              Margin="280,24,280,24"
              CornerRadius="8"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Monaco Editor -->
                <RowDefinition Height="Auto"/> <!-- Tags -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBox x:Name="TitleBox"
                     PlaceholderText="Title"
                     FontSize="24"
                     FontWeight="SemiBold"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0,0,0,16"/>

            <!-- Monaco Editor -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,16">
                <WebView2 x:Name="MonacoEditor"
                          DefaultBackgroundColor="Transparent"/>
            </Border>

            <!-- Tags Section -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Tags" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="60">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsRepeater x:Name="ExistingTagsRepeater"
                                       ElementPrepared="ExistingTagsRepeater_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <ToggleButton Content="{x:Bind}" 
                                                  CornerRadius="16"
                                                  FontSize="12"
                                                  Padding="12,6"
                                                  Click="Tag_Click"/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        
                        <TextBox x:Name="NewTagBox" 
                                 PlaceholderText="+ Add Tag" 
                                 CornerRadius="16"
                                 BorderThickness="1"
                                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                 Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                 KeyDown="NewTagBox_KeyDown"
                                 Width="160"
                                 Padding="12,6"
                                 FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton"
                        Content="Delete" 
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DeleteButton_Click"
                        Padding="16,8"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Click="CopyButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTipService.ToolTip="Copy content">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Save" 
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="SaveButton_Click"
                            Padding="24,8"/>
                    <Button Content="Close" 
                            Click="CloseButton_Click"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
