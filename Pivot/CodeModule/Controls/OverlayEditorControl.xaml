<UserControl
    x:Class="Pivot.CodeModule.Controls.OverlayEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pivot.CodeModule.ViewModels"
    xmlns:controls="using:Pivot.CodeModule.Controls"
    xmlns:converters="using:Pivot.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:CodeEditorViewModel}">

    <UserControl.Resources>
        <converters:TagSelectionConverter x:Key="TagSelectionConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Dimmed Background -->
        <Border Background="#80000000" 
                PointerPressed="Background_PointerPressed"/>

        <!-- Editor Card -->
        <Grid HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch"
              Margin="280,24,280,24"
              CornerRadius="8"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Monaco Editor -->
                <RowDefinition Height="Auto"/> <!-- Tags -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBox x:Name="TitleBox"
                     PlaceholderText="Title"
                     FontSize="24"
                     FontWeight="SemiBold"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0,0,0,16"/>

            <!-- Monaco Editor -->
            <controls:MonacoEditorControl x:Name="MonacoEditor"
                                          Grid.Row="1"
                                          Text="{x:Bind ViewModel.TextContent, Mode=TwoWay}"
                                          EditorLanguage="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay}"
                                          CornerRadius="8"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          Margin="0,0,0,16"/>

            <!-- Tags Section -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Tags" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="60">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid CornerRadius="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <Button Grid.Column="1" Click="RemoveTag_Click" Background="Transparent" BorderThickness="0" Padding="0" Height="20" Width="20" CornerRadius="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <AutoSuggestBox x:Name="TagInput" 
                                        PlaceholderText="+ Tag"
                                        Width="100"
                                        TextChanged="TagInput_TextChanged"
                                        QuerySubmitted="TagInput_QuerySubmitted"
                                        SuggestionChosen="TagInput_SuggestionChosen"
                                        VerticalAlignment="Center"/>
                        
                        <Button Background="Transparent" BorderThickness="0" Padding="8,4" Height="32" VerticalAlignment="Center" ToolTipService.ToolTip="Select from existing tags">
                            <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                            <Button.Flyout>
                                <Flyout x:Name="AvailableTagsFlyout" Placement="Bottom">
                                    <Grid Width="200" MaxHeight="300">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Available Tags" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                                        <ListView ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="AvailableTag_ItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" Padding="0,4"/>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton"
                        Content="Delete" 
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DeleteButton_Click"
                        Padding="16,8"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Click="CopyButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTipService.ToolTip="Copy content">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
