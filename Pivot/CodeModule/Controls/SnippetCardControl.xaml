<UserControl
    x:Class="Pivot.CodeModule.Controls.SnippetCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Pivot.Converters"
    mc:Ignorable="d"
    x:Name="RootControl">
    
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:JsonTagsToCollectionConverter x:Key="JsonTagsToCollectionConverter"/>
        <MenuFlyout x:Key="CardContextMenu">
            <MenuFlyoutItem Text="Copy" Click="CopyMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Duplicate" Click="DuplicateMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C1;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Click="DeleteMenuItem_Click" Foreground="Red"/>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid CornerRadius="8" 
          Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
          BorderThickness="1"
          Padding="12"
          ContextFlyout="{StaticResource CardContextMenu}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selection Checkbox -->
        <CheckBox Grid.RowSpan="3" 
                  VerticalAlignment="Top" 
                  HorizontalAlignment="Right"
                  IsChecked="{x:Bind Asset.IsSelected, Mode=TwoWay}"
                  Visibility="{Binding DataContext.ViewModel.ListVM.IsSelectionMode, ElementName=RootPage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                  Margin="0,-8,-8,0"
                  Canvas.ZIndex="10"/>

        <!-- Header Row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{Binding Asset.FileName, ElementName=RootControl}" 
                       Style="{StaticResource BodyStrongTextBlockStyle}" 
                       TextTrimming="CharacterEllipsis" 
                       VerticalAlignment="Center"/>
            
            <!-- Copy Button -->
            <Button Grid.Column="1" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="4"
                    Click="CopyButton_Click"
                    ToolTipService.ToolTip="Copy content">
                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Preview Content -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding Asset.ContentIndex, ElementName=RootControl}" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   MaxLines="8" 
                   TextTrimming="CharacterEllipsis" 
                   TextWrapping="Wrap"
                   Margin="0,8,0,8" />

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Asset.Tool, ElementName=RootControl}" 
                       FontSize="10" Opacity="0.6" />
             <!-- Chips could go here -->
             <ItemsControl ItemsSource="{Binding Asset.UserTagsJson, ElementName=RootControl, Converter={StaticResource JsonTagsToCollectionConverter}}">
                 <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                         <StackPanel Orientation="Horizontal" Spacing="4"/>
                     </ItemsPanelTemplate>
                 </ItemsControl.ItemsPanel>
                 <ItemsControl.ItemTemplate>
                     <DataTemplate>
                         <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="4,2">
                             <TextBlock Text="{Binding}" FontSize="10"/>
                         </Border>
                     </DataTemplate>
                 </ItemsControl.ItemTemplate>
             </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>

