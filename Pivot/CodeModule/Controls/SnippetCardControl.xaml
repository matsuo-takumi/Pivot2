<UserControl
    x:Class="Pivot.CodeModule.Controls.SnippetCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <Grid CornerRadius="8" 
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
          BorderThickness="1"
          Padding="12">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="{Binding Asset.FileName, ElementName=RootControl}" 
                   Style="{StaticResource BodyStrongTextBlockStyle}" 
                   TextTrimming="CharacterEllipsis" />

        <!-- Preview Content -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding Asset.ContentIndex, ElementName=RootControl}" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   MaxLines="8" 
                   TextTrimming="CharacterEllipsis" 
                   TextWrapping="Wrap"
                   Margin="0,8,0,8" />

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Asset.Tool, ElementName=RootControl}" 
                       FontSize="10" Opacity="0.6" />
        </StackPanel>
    </Grid>
</UserControl>

