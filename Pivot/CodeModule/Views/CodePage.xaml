<Page
    x:Class="Pivot.CodeModule.Views.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pivot.CodeModule.ViewModels"
    xmlns:model="using:Pivot.CodeModule.Models">

    

    <Grid ColumnDefinitions="300,*" Padding="12">
        <!-- Sidebar: search, new, list -->
        <StackPanel Grid.Column="0" Spacing="8">
            <TextBox PlaceholderText="Search snippets..." Text="{Binding SearchQuery, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Search" Command="{Binding SearchCommand}" />
                <Button Content="＋ New" Command="{Binding AddSnippetCommand}" />
                <Button Content="Delete" Command="{Binding DeleteSnippetCommand}" />
            </StackPanel>

            <!-- Left side remains controls; cards moved to main area -->
            <TextBlock Text="Snippets" Margin="0,12,0,4" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Snippets}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:CodeFile">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Margin="6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Editor area: toolbar + editor -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" ColumnDefinitions="*">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8" CornerRadius="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBox Width="280" PlaceholderText="Title" Text="{Binding SelectedSnippet.Title, Mode=TwoWay, TargetNullValue=''}" />
                    <ComboBox Width="140" SelectedItem="{Binding SelectedSnippet.Language, Mode=TwoWay}" PlaceholderText="Language">
                        <x:String>Python</x:String>
                        <x:String>VEX</x:String>
                        <x:String>MEL</x:String>
                        <x:String>C++</x:String>
                        <x:String>Unreal</x:String>
                        <x:String>Text</x:String>
                    </ComboBox>
                    <Button Content="Save" Command="{Binding SaveSnippetCommand}" />
                    <TextBlock Text="" Width="12" />
                    <TextBlock Text="(Ctrl/Cmd+S to save)" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Main area: show cards when no selection, editor when selected -->
                <Grid>
                    <Grid x:Name="CardPanel">
                        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Auto">
                            <ListView ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet, Mode=TwoWay}" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="model:CodeFile">
                                        <Border Width="260" Height="150" Margin="8" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind Content}" Foreground="#444" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="6" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <TextBlock Text="{x:Bind Language}" Foreground="Gray" FontSize="12" />
                                                    <TextBlock Text="·" Foreground="Gray" />
                                                    <TextBlock Text="{x:Bind Updated}" Foreground="Gray" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="EditorPanel" Visibility="Collapsed">
                        <WebView2 x:Name="CodeEditor" Source="ms-appx-web:///Assets/Editor/index.html" />
                        <Border x:Name="PlaceholderBorder" Background="#80FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Select a snippet or create a new one" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="左の一覧から選択するか「＋ New」を押してください" Foreground="Gray" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>


