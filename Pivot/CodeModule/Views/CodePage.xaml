<Page
    x:Class="Pivot.CodeModule.Views.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Pivot.CodeModule.Controls"
    xmlns:models="using:Pivot.Models"
    xmlns:converters="using:Pivot.Converters"
    xmlns:viewmodels="using:Pivot.CodeModule.ViewModels"
    mc:Ignorable="d"
    x:Name="RootPage">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CodeLayoutConverter x:Key="LayoutConverter"/>
        <converters:BoolToIconConverter x:Key="BoolToIconConverter"/>
        <converters:SelectionToBackgroundConverter x:Key="SelectionToBackgroundConverter"/>
        <converters:TagDeleteVisibilityConverter x:Key="TagDeleteVis"/>
        <converters:BoolToSelectionModeConverter x:Key="BoolToSelectionModeConverter"/>
        <converters:BooleanNegationConverter x:Key="BoolNegationConverter"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Filters -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Layout Toggle -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Code Library" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                
                <!-- Delete Selected Button (Visible when Selection Mode) -->
                <Button Grid.Column="1" 
                        Command="{x:Bind ViewModel.ListVM.DeleteSelectedCommand}"
                        Visibility="{x:Bind ViewModel.ListVM.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,4,0">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="Red"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Delete Selected"/>
                    </ToolTipService.ToolTip>
                </Button>

                <!-- Select Mode Toggle -->
                <Button Grid.Column="2" 
                        Command="{x:Bind ViewModel.ListVM.ToggleSelectionModeCommand}"
                        Background="{x:Bind ViewModel.ListVM.IsSelectionMode, Mode=OneWay, Converter={StaticResource SelectionToBackgroundConverter}}"
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,4,0">
                    <FontIcon Glyph="&#xE762;" FontSize="16"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Select Items"/>
                    </ToolTipService.ToolTip>
                </Button>

                <!-- Layout Toggle -->
                <Button Grid.Column="3" 
                        Command="{x:Bind ViewModel.ListVM.ToggleLayoutCommand}"
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,4,0">
                    <FontIcon Glyph="{x:Bind ViewModel.ListVM.IsGridLayout, Mode=OneWay, Converter={StaticResource BoolToIconConverter}, ConverterParameter='Grid'}" FontSize="16"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Toggle Layout"/>
                    </ToolTipService.ToolTip>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="4" 
                        Command="{x:Bind ViewModel.ListVM.ImportCommand}"
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,4,0">
                    <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Import from JSON"/>
                    </ToolTipService.ToolTip>
                </Button>

                <!-- Export Button -->
                <Button Grid.Column="5" 
                        Command="{x:Bind ViewModel.ListVM.ExportCommand}"
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="8">
                    <FontIcon Glyph="&#xEDE1;" FontSize="16"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Export to JSON"/>
                    </ToolTipService.ToolTip>
                </Button>
            </Grid>
            
            <!-- Tag List -->
            <ListView Grid.Row="1" 
                      ItemsSource="{x:Bind ViewModel.FilterVM.Tags, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectedItem="{x:Bind ViewModel.FilterVM.SelectedTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="0,4" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EC;" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Command="{Binding DataContext.FilterVM.DeleteTagCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    Width="24" 
                                    Height="24" 
                                    CornerRadius="12"
                                    Margin="4,0,0,0"
                                    Visibility="{Binding Converter={StaticResource TagDeleteVis}}">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.4"/>
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="Delete Tag (Global)"/>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Quick Add -->
                <RowDefinition Height="Auto"/> <!-- Search & Sort -->
                <RowDefinition Height="*"/>    <!-- Grid -->
            </Grid.RowDefinitions>

            <!-- Quick Add Bar -->
            <local:QuickAddControl x:Name="QuickAddBar" 
                                   Grid.Row="0" 
                                   Margin="0,0,0,24"
                                   SnippetCreated="QuickAddBar_SnippetCreated"/>

            <!-- Search & Sort Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox PlaceholderText="Search snippets..." 
                         Text="{x:Bind ViewModel.ListVM.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0"/>
                         
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding ViewModel.ListVM.SortOptions}" 
                          SelectedItem="{Binding ViewModel.ListVM.SelectedSortOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          MinWidth="160"
                          PlaceholderText="Sort by..."/>
            </Grid>

            <!-- Card View -->
            <GridView x:Name="SnippetsGridView"
                      Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.ListVM.Snippets, Mode=OneWay}"
                      CanReorderItems="{x:Bind ViewModel.ListVM.CanReorder, Mode=OneWay}"
                      CanDragItems="{x:Bind ViewModel.ListVM.CanReorder, Mode=OneWay}"
                      AllowDrop="True"
                      SelectionMode="{x:Bind ViewModel.ListVM.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToSelectionModeConverter}}"
                      IsItemClickEnabled="{x:Bind ViewModel.ListVM.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                      ItemClick="SnippetsGridView_ItemClick"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Background="Transparent"
                      Padding="0,0,0,100">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" 
                                       ItemWidth="300" 
                                       ItemHeight="200"
                                       MaximumRowsOrColumns="10"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AssetEntity">
                        <local:SnippetCardControl Asset="{x:Bind}" 
                                                  HorizontalAlignment="Stretch" 
                                                  VerticalAlignment="Stretch"/>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- Floating Overlay Editor -->
        <local:OverlayEditorControl Grid.ColumnSpan="2"
                                    Visibility="{x:Bind ViewModel.EditorVM.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    DataContext="{x:Bind ViewModel.EditorVM}"/>
    </Grid>
</Page>
