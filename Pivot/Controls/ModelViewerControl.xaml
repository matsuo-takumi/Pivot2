<UserControl
    x:Class="Pivot.Controls.ModelViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hx="using:HelixToolkit.WinUI"
    xmlns:local="using:Pivot.Controls"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    IsTabStop="True">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ViewportMicaBackgroundBrush" Color="#F3F3F3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ViewportMicaBackgroundBrush" Color="#202020"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <local:VulkanSwapChainPanel x:Name="VulkanPanel"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

        <!-- Axis Gizmo -->
        <local:AxisGizmo x:Name="AxisGizmoControl"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"/>

        <!-- Controls Overlay -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="8" Orientation="Horizontal">
            <Button x:Name="FitButton" Click="FitButton_Click" ToolTipService.ToolTip="Fit to View (F)" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8">
                <FontIcon Glyph="&#xE9A6;" FontSize="14"/>
            </Button>
        </StackPanel>
        
        <Border x:Name="ErrorMessageBorder"
                Background="#CC000000"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorMessageText"
                          Text="モデルの読み込みに失敗しました"
                          Foreground="White"
                          FontSize="14"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          MaxWidth="400"/>
                <TextBlock x:Name="ErrorDetailText"
                          Text=""
                          Foreground="#CCCCCC"
                          FontSize="12"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          MaxWidth="400"
                          Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        
        <Border x:Name="LoadingIndicator"
                Background="#80000000"
                CornerRadius="8"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="40" Height="40"/>
                <TextBlock Text="モデルを読み込み中..."
                          Foreground="White"
                          FontSize="12"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


