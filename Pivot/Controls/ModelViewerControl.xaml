<UserControl
    x:Class="Pivot.Controls.ModelViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hx="using:HelixToolkit.WinUI"
    xmlns:local="using:Pivot.Controls"
    xmlns:models="using:Pivot.Models"
    xmlns:views="using:Pivot.Views"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    IsTabStop="True">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ViewportMicaBackgroundBrush" Color="#F3F3F3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ViewportMicaBackgroundBrush" Color="#202020"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <SwapChainPanel x:Name="VulkanSwapChainPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>


        <!-- Axis Gizmo -->
        <local:AxisGizmo x:Name="AxisGizmoControl"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"/>

        <!-- Top-Right Controls Overlay -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="4" Orientation="Horizontal">
            <!-- Toggle Buttons for Texture, Vertex Color, Material -->
            <ToggleButton x:Name="TextureToggleButton" 
                          IsChecked="{x:Bind _viewModel.UseTexture, Mode=TwoWay}"
                          ToolTipService.ToolTip="Texture"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                          Padding="8">
                <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="VertexColorToggleButton" 
                          IsChecked="{x:Bind _viewModel.UseVertexColor, Mode=TwoWay}"
                          ToolTipService.ToolTip="Vertex Color"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                          Padding="8">
                <FontIcon Glyph="&#xE790;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="MaterialToggleButton" 
                          IsChecked="{x:Bind _viewModel.UseMaterial, Mode=TwoWay}"
                          ToolTipService.ToolTip="Material (PBR)"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                          Padding="8">
                <FontIcon Glyph="&#xE771;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="UVCheckerToggleButton" 
                          IsChecked="{x:Bind _viewModel.UseUVChecker, Mode=TwoWay}"
                          ToolTipService.ToolTip="UV Checker"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                          Padding="8">
                <FontIcon Glyph="&#xED63;" FontSize="14"/>
            </ToggleButton>
            
            <!-- Shading Mode Dropdown -->
            <DropDownButton x:Name="ShadingModeButton" ToolTipService.ToolTip="Shading Mode"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8">
                <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="LitModeItem" Text="Lit (Alt+1)" Command="{x:Bind _viewModel.SetShadingModeCommand}" CommandParameter="{x:Bind models:ShadingMode.Lit}"/>
                        <MenuFlyoutItem x:Name="DepthModeItem" Text="Depth (Alt+2)" Command="{x:Bind _viewModel.SetShadingModeCommand}" CommandParameter="{x:Bind models:ShadingMode.Depth}"/>
                        <MenuFlyoutItem x:Name="NormalModeItem" Text="World Normal (Alt+3)" Command="{x:Bind _viewModel.SetShadingModeCommand}" CommandParameter="{x:Bind models:ShadingMode.WorldNormal}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="BlendModeItem" Text="Blend (Alt+4)" Command="{x:Bind _viewModel.SetShadingModeCommand}" CommandParameter="{x:Bind models:ShadingMode.Combined}"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            
            <!-- Fit to View Button -->
            <Button x:Name="FitButton" Command="{x:Bind _viewModel.ResetCameraCommand}" ToolTipService.ToolTip="Fit to View (F)" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8">
                <FontIcon Glyph="&#xE9A6;" FontSize="14"/>
            </Button>
        </StackPanel>
        
        <!-- Bottom-Right Settings Buttons -->
        <StackPanel HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="12"
                    Orientation="Horizontal"
                    Spacing="8">
            
            <!-- Lighting Settings Button -->
            <DropDownButton x:Name="LightingSettingsButton" 
                            ToolTipService.ToolTip="Lighting Settings"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                            Padding="8">
                <FontIcon Glyph="&#xE706;" FontSize="14"/>
                <DropDownButton.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <views:LightingSettingsView x:Name="FloatingLightingSettings" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            
            <!-- Material Settings Button -->
            <DropDownButton x:Name="MaterialSettingsButton" 
                            ToolTipService.ToolTip="Material Settings"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                            Padding="8">
                <FontIcon Glyph="&#xE771;" FontSize="14"/>
                <DropDownButton.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <views:MaterialSettingsView x:Name="FloatingMaterialSettings" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
        
        <!-- Info Overlay -->
        <Border x:Name="InfoOverlay"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Padding="8"
                Background="#80000000"
                CornerRadius="4">
            <StackPanel Spacing="2">
                <!-- Viewport Stats -->
                <TextBlock x:Name="FpsText" Text="FPS: --" Foreground="Lime" FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="ResolutionText" Text="Resolution: -- x --" Foreground="Cyan" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
                <TextBlock x:Name="ViewportSizeText" Text="Viewport: -- x --" Foreground="Cyan" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
                <TextBlock x:Name="CameraInfoText" Text="Camera: --" Foreground="Yellow" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
                
                <!-- Separator -->
                <Border x:Name="InfoSeparator" Height="1" Background="#40FFFFFF" Margin="0,4,0,4" Visibility="Collapsed"/>
                
                <!-- Model Stats -->
                <TextBlock x:Name="PolygonCountText" Text="{x:Bind _viewModel.PolygonCountString, Mode=OneWay}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="VertexCountText" Text="{x:Bind _viewModel.VertexCountString, Mode=OneWay}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="UVSetCountText" Text="{x:Bind _viewModel.UvSetCountString, Mode=OneWay}" Foreground="White" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
                <TextBlock x:Name="MaterialCountText" Text="{x:Bind _viewModel.MaterialCountString, Mode=OneWay}" Foreground="White" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
                <TextBlock x:Name="BoundingBoxText" Text="{x:Bind _viewModel.BoundsString, Mode=OneWay}" Foreground="White" FontFamily="Consolas" FontSize="11" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        
        <Border x:Name="ErrorMessageBorder"
                Background="#CC000000"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorMessageText"
                          Text="モデルの読み込みに失敗しました"
                          Foreground="White"
                          FontSize="14"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          MaxWidth="400"/>
                <TextBlock x:Name="ErrorDetailText"
                          Text=""
                          Foreground="#CCCCCC"
                          FontSize="12"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          MaxWidth="400"
                          Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        
        <Border x:Name="LoadingIndicator"
                Background="#80000000"
                CornerRadius="8"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Visible">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="40" Height="40"/>
                <TextBlock x:Name="LoadingText" Text="ビューポートを初期化中..."
                          Foreground="White"
                          FontSize="12"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


