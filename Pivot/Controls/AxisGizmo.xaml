<UserControl
    x:Class="Pivot.Controls.AxisGizmo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="90" Height="90">

    <Border Background="#60202020" CornerRadius="8" Padding="5">
        <Canvas x:Name="GizmoCanvas" Width="80" Height="80">
            <!-- X Axis (Red) -->
            <Line x:Name="XAxis" X1="40" Y1="40" X2="70" Y2="40" 
                  Stroke="#FF5252" StrokeThickness="3"/>
            <TextBlock x:Name="XLabel" Text="X" Foreground="#FF5252" FontWeight="Bold" FontSize="11"
                       Canvas.Left="68" Canvas.Top="30"/>
            
            <!-- Y Axis (Green) -->
            <Line x:Name="YAxis" X1="40" Y1="40" X2="40" Y2="10" 
                  Stroke="#69F0AE" StrokeThickness="3"/>
            <TextBlock x:Name="YLabel" Text="Y" Foreground="#69F0AE" FontWeight="Bold" FontSize="11"
                       Canvas.Left="43" Canvas.Top="0"/>
            
            <!-- Z Axis (Blue) -->
            <Line x:Name="ZAxis" X1="40" Y1="40" X2="20" Y2="60" 
                  Stroke="#448AFF" StrokeThickness="3"/>
            <TextBlock x:Name="ZLabel" Text="Z" Foreground="#448AFF" FontWeight="Bold" FontSize="11"
                       Canvas.Left="8" Canvas.Top="56"/>
            
            <!-- Center circle -->
            <Ellipse Width="10" Height="10" Fill="#CCCCCC" Canvas.Left="35" Canvas.Top="35"/>
        </Canvas>
    </Border>
</UserControl>

