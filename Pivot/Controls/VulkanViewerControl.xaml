<UserControl
    x:Class="Pivot.Controls.VulkanViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <Grid>
        <SwapChainPanel x:Name="VulkanSwapChainPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
        
        <!-- Debug Overlay -->
        <StackPanel x:Name="DebugOverlay"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="8"
                    Background="#80000000"
                    CornerRadius="4"
                    Visibility="Visible">
            <TextBlock x:Name="DebugFpsText"
                       Text="FPS: --"
                       Foreground="Lime"
                       FontFamily="Consolas"
                       FontSize="12"/>
            <TextBlock x:Name="DebugSizeText"
                       Text="Size: -- x --"
                       Foreground="Cyan"
                       FontFamily="Consolas"
                       FontSize="12"/>
            <TextBlock x:Name="DebugStatusText"
                       Text="Status: Initializing..."
                       Foreground="Yellow"
                       FontFamily="Consolas"
                       FontSize="12"/>
        </StackPanel>
        
        <!-- Error Overlay -->
        <Border x:Name="ErrorOverlay"
                Background="#CC000000"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText"
                           Text="Vulkan initialization failed"
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
