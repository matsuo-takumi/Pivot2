<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pivot.Controls.UnifiedBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Controls"
    xmlns:utils="using:Pivot.Utilities"
    xmlns:models="using:Pivot.Models"
    xmlns:converters="using:Pivot.Converters"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SelectionToBorderBrushConverter x:Key="SelectionConverter"/>
        <converters:SelectionToBorderThicknessConverter x:Key="SelectionThicknessConverter"/>
        <!-- Card Template for Masonry/Grid layouts -->
        <DataTemplate x:Key="AssetCardTemplate" x:DataType="models:AssetEntity">
            <Grid Margin="2" CanDrag="True" DragStarting="ItemBorder_DragStarting">
                <!-- Card content (no selection border here) -->
                <Border x:Name="ItemBorder" 
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Placeholder background using DominantColor -->
                        <Border Grid.Row="0" 
                                CornerRadius="4,4,0,0"
                                MinHeight="120">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Bind utils:ColorHelper.ParseColor(DominantColor), FallbackValue='#404040'}"/>
                            </Border.Background>
                            
                            <!-- Thumbnail image -->
                            <Image Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0"
                                   ImageOpened="Image_ImageOpened">
                                <Image.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.3"/>
                                </Image.OpacityTransition>
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind DisplayImageSource}"
                                                 DecodePixelWidth="300"
                                                 DecodePixelType="Logical"/>
                                </Image.Source>
                            </Image>
                        </Border>
                        
                        <!-- File name footer -->
                        <TextBlock Grid.Row="1" 
                                   Text="{x:Bind FileName}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Padding="6,4"
                                   MaxLines="1"/>
                    </Grid>
                </Border>
                
                <!-- Selection overlay border (on top of content, doesn't affect layout) -->
                <Border CornerRadius="4"
                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionThicknessConverter}}"
                        BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionConverter}}"
                        IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <!-- List Template for detailed row view -->
        <DataTemplate x:Key="AssetListTemplate" x:DataType="models:AssetEntity">
            <Border x:Name="ItemBorder"
                    Margin="2" 
                    Padding="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionThicknessConverter}}"
                    BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionConverter}}"
                    CanDrag="True"
                    DragStarting="ItemBorder_DragStarting">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Small thumbnail -->
                    <Border Grid.Column="0" 
                            Width="40" Height="40"
                            CornerRadius="4">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind utils:ColorHelper.ParseColor(DominantColor), FallbackValue='#404040'}"/>
                        </Border.Background>
                        <Image Stretch="UniformToFill"
                               Opacity="0"
                               ImageOpened="Image_ImageOpened">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.3"/>
                            </Image.OpacityTransition>
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind DisplayImageSource}"
                                             DecodePixelWidth="48"
                                             DecodePixelType="Logical"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    
                    <!-- File name -->
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind FileName}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"/>
                    
                    <!-- Date -->
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind LastModifiedUtc}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    
                    <!-- Size -->
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind utils:FileSizeHelper.FormatSize(FileSize)}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template Selector -->
        <local:LayoutBasedTemplateSelector x:Key="LayoutTemplateSelector"
                                           CardTemplate="{StaticResource AssetCardTemplate}"
                                           ListTemplate="{StaticResource AssetListTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FilterBar -->
        <Border Grid.Row="0"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Padding="12,8"
                CornerRadius="6"
                Margin="0,0,0,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         PlaceholderText="Search files..."
                         TextChanged="SearchBox_TextChanged"/>
                
                <!-- Rating Filter -->
                <ComboBox x:Name="RatingFilter"
                          Grid.Column="1"
                          Width="120"
                          PlaceholderText="Rating"
                          SelectionChanged="RatingFilter_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="0"/>
                    <ComboBoxItem Content="★ 1+" Tag="1"/>
                    <ComboBoxItem Content="★★ 2+" Tag="2"/>
                    <ComboBoxItem Content="★★★ 3+" Tag="3"/>
                    <ComboBoxItem Content="★★★★ 4+" Tag="4"/>
                    <ComboBoxItem Content="★★★★★ 5" Tag="5"/>
                </ComboBox>
                
                <!-- Sort Field -->
                <ComboBox x:Name="SortFieldCombo"
                          Grid.Column="2"
                          Width="100"
                          SelectionChanged="SortField_SelectionChanged">
                    <ComboBoxItem Content="Date" Tag="Date" IsSelected="True"/>
                    <ComboBoxItem Content="Name" Tag="Name"/>
                    <ComboBoxItem Content="Size" Tag="Size"/>
                    <ComboBoxItem Content="Rating" Tag="Rating"/>
                </ComboBox>
                
                <!-- Sort Direction -->
                <Button x:Name="SortDirectionButton"
                        Grid.Column="3"
                        Click="SortDirection_Click"
                        ToolTipService.ToolTip="Toggle Sort Direction"
                        Padding="8">
                    <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="14"/>
                </Button>
                
                <!-- Loading Indicator (in filter bar) -->
                <StackPanel x:Name="FilterBarLoadingIndicator"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <ProgressRing IsActive="True" Width="16" Height="16"/>
                    <TextBlock x:Name="FilterBarLoadingText" 
                               Text="Loading..." 
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area with ItemsRepeater -->
        <!-- CRITICAL: CanContentRenderOutsideBounds=True enables ItemsRepeater virtualization -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentRenderOutsideBounds="True">
            <ItemsRepeater x:Name="AssetRepeater"
                           ItemTemplate="{StaticResource LayoutTemplateSelector}"
                           Tapped="AssetRepeater_Tapped"
                           DoubleTapped="AssetRepeater_DoubleTapped"
                           RightTapped="AssetRepeater_RightTapped"
                           ElementPrepared="AssetRepeater_ElementPrepared"
                           ElementClearing="AssetRepeater_ElementClearing">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="180"
                                       MinItemHeight="180"
                                       MinRowSpacing="2"
                                       MinColumnSpacing="2"
                                       ItemsStretch="Uniform"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="1"
                      IsActive="False"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <FontIcon Glyph="&#xE7C3;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="No items found" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Padding="12,8"
                CornerRadius="6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="LayoutButton"
                            Click="LayoutButton_Click"
                            ToolTipService.ToolTip="Change Layout"
                            Padding="8">
                        <FontIcon x:Name="LayoutIcon" Glyph="&#xE80A;" FontSize="14"/>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="Refresh"
                            Padding="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
