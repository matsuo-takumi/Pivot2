<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pivot.Controls.UnifiedBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Controls"
    xmlns:models="using:Pivot.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Card Template for Masonry/Grid layouts -->
        <DataTemplate x:Key="AssetCardTemplate" x:DataType="models:AssetEntity">
            <Border Margin="4"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    PointerPressed="Item_PointerPressed"
                    DoubleTapped="Item_DoubleTapped"
                    RightTapped="Item_RightTapped"
                    CanDrag="True"
                    DragStarting="Item_DragStarting">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Placeholder background using DominantColor - Height set from AspectRatio -->
                    <Border Grid.Row="0" 
                            CornerRadius="6,6,0,0"
                            MinHeight="120">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind local:ColorHelper.ParseColor(DominantColor), FallbackValue='#404040'}"/>
                        </Border.Background>
                        
                        <!-- Thumbnail image with fade-in -->
                        <Image Source="{x:Bind ThumbnailPath, TargetNullValue=''}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- File name footer -->
                    <TextBlock Grid.Row="1" 
                               Text="{x:Bind FileName}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Padding="8,6"
                               MaxLines="1"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- List Template for detailed row view -->
        <DataTemplate x:Key="AssetListTemplate" x:DataType="models:AssetEntity">
            <Border Margin="2" 
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4"
                    PointerPressed="Item_PointerPressed"
                    DoubleTapped="Item_DoubleTapped"
                    RightTapped="Item_RightTapped"
                    CanDrag="True"
                    DragStarting="Item_DragStarting">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Small thumbnail -->
                    <Border Grid.Column="0" 
                            Width="40" Height="40"
                            CornerRadius="4">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind local:ColorHelper.ParseColor(DominantColor), FallbackValue='#404040'}"/>
                        </Border.Background>
                        <Image Source="{x:Bind ThumbnailPath, TargetNullValue=''}"
                               Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- File name -->
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind FileName}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"/>
                    
                    <!-- Date -->
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind LastModifiedUtc}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    
                    <!-- Size -->
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind local:FileSizeHelper.FormatSize(FileSize)}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template Selector -->
        <local:LayoutBasedTemplateSelector x:Key="LayoutTemplateSelector"
                                           CardTemplate="{StaticResource AssetCardTemplate}"
                                           ListTemplate="{StaticResource AssetListTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FilterBar -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,8"
                CornerRadius="6"
                Margin="0,0,0,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         PlaceholderText="Search files..."
                         TextChanged="SearchBox_TextChanged"/>
                
                <!-- Rating Filter -->
                <ComboBox x:Name="RatingFilter"
                          Grid.Column="1"
                          Width="120"
                          PlaceholderText="Rating"
                          SelectionChanged="RatingFilter_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="0"/>
                    <ComboBoxItem Content="★ 1+" Tag="1"/>
                    <ComboBoxItem Content="★★ 2+" Tag="2"/>
                    <ComboBoxItem Content="★★★ 3+" Tag="3"/>
                    <ComboBoxItem Content="★★★★ 4+" Tag="4"/>
                    <ComboBoxItem Content="★★★★★ 5" Tag="5"/>
                </ComboBox>
                
                <!-- Sort Field -->
                <ComboBox x:Name="SortFieldCombo"
                          Grid.Column="2"
                          Width="100"
                          SelectionChanged="SortField_SelectionChanged">
                    <ComboBoxItem Content="Date" Tag="Date" IsSelected="True"/>
                    <ComboBoxItem Content="Name" Tag="Name"/>
                    <ComboBoxItem Content="Size" Tag="Size"/>
                    <ComboBoxItem Content="Rating" Tag="Rating"/>
                </ComboBox>
                
                <!-- Sort Direction -->
                <Button x:Name="SortDirectionButton"
                        Grid.Column="3"
                        Click="SortDirection_Click"
                        ToolTipService.ToolTip="Toggle Sort Direction"
                        Padding="8">
                    <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main content area with ItemsRepeater -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="AssetRepeater"
                           ItemTemplate="{StaticResource LayoutTemplateSelector}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200"
                                       MinItemHeight="200"
                                       MinRowSpacing="4"
                                       MinColumnSpacing="4"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="1"
                      IsActive="False"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <FontIcon Glyph="&#xE7C3;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="No items found" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,8"
                CornerRadius="6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="LayoutButton"
                            Click="LayoutButton_Click"
                            ToolTipService.ToolTip="Change Layout"
                            Padding="8">
                        <FontIcon x:Name="LayoutIcon" Glyph="&#xE80A;" FontSize="14"/>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="Refresh"
                            Padding="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
