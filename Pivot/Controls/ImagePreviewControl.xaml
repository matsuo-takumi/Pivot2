<UserControl
    x:Class="Pivot.Controls.ImagePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ImagePreviewOverlay" 
          Visibility="Collapsed" 
          Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
          PointerPressed="ImagePreviewOverlay_PointerPressed">

        <Border x:Name="ImagePreviewContainer"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <ScrollViewer x:Name="ImagePreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.1"
                          MaxZoomFactor="5.0"
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch">
                
                <Image x:Name="ImagePreviewImage" 
                       Stretch="Uniform"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Close button (top right) -->
        <Button x:Name="ImagePreviewCloseButton"
                Click="ImagePreviewCloseButton_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,20,0"
                Style="{StaticResource SubtleButtonStyle}" 
                Padding="8">
            <FontIcon Glyph="&#xE711;" FontSize="16"/>
        </Button>
    </Grid>
</UserControl>
