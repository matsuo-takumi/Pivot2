<UserControl
    x:Class="Pivot.Controls.ImagePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ImagePreviewOverlay" 
          Visibility="Collapsed" 
          PointerPressed="ImagePreviewOverlay_PointerPressed">
        
        <Grid.Background>
            <AcrylicBrush TintColor="Black" TintOpacity="0.4" FallbackColor="#99000000"/>
        </Grid.Background>

        <Border x:Name="ImagePreviewContainer"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Margin="20,60,20,20">
            <ScrollViewer x:Name="ImagePreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.1"
                          MaxZoomFactor="500.0"
                          PointerPressed="ImagePreviewScrollViewer_PointerPressed"
                          PointerMoved="ImagePreviewScrollViewer_PointerMoved"
                          PointerReleased="ImagePreviewScrollViewer_PointerReleased"
                          PointerCanceled="ImagePreviewScrollViewer_PointerReleased"
                          PointerWheelChanged="ImagePreviewScrollViewer_PointerWheelChanged"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch">
                
                <!-- Pattern tiling using ImageBrush TileMode -->
                <Grid x:Name="PatternContainer">
                    <Grid x:Name="PatternGrid" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 9 Images will be added here in code-behind or statically if preferred -->
                        <Image x:Name="P00" Grid.Row="0" Grid.Column="0" Stretch="None"/>
                        <Image x:Name="P01" Grid.Row="0" Grid.Column="1" Stretch="None"/>
                        <Image x:Name="P02" Grid.Row="0" Grid.Column="2" Stretch="None"/>
                        <Image x:Name="P10" Grid.Row="1" Grid.Column="0" Stretch="None"/>
                        <Image x:Name="P11" Grid.Row="1" Grid.Column="1" Stretch="None"/>
                        <Image x:Name="P12" Grid.Row="1" Grid.Column="2" Stretch="None"/>
                        <Image x:Name="P20" Grid.Row="2" Grid.Column="0" Stretch="None"/>
                        <Image x:Name="P21" Grid.Row="2" Grid.Column="1" Stretch="None"/>
                        <Image x:Name="P22" Grid.Row="2" Grid.Column="2" Stretch="None"/>
                    </Grid>
                    
                    <Image x:Name="ImagePreviewImage" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           DoubleTapped="ImagePreviewImage_DoubleTapped"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Toolbar (top center) -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    Margin="0,20,0,0"
                    Spacing="4">
            <ToggleButton x:Name="PatternPreviewToggle"
                          ToolTipService.ToolTip="パターンプレビュー"
                          Click="PatternPreviewToggle_Click"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          Padding="8"
                          Width="36" Height="36">
                <FontIcon Glyph="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </ToggleButton>
        </StackPanel>

        <!-- Close button (top right) -->
        <Button x:Name="ImagePreviewCloseButton"
                Click="ImagePreviewCloseButton_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,20,0"
                Style="{StaticResource SubtleButtonStyle}" 
                Padding="8">
            <FontIcon Glyph="&#xE711;" FontSize="16"/>
        </Button>
    </Grid>
</UserControl>
