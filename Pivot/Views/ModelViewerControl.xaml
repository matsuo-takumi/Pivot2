<UserControl
    x:Class="Pivot.Views.ModelViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SystemControlAcrylicElementBrush}">
        <!-- 3D Viewport - HelixToolkit.WinUIの実際のAPIに合わせて修正が必要 -->
        <!-- 暫定的にSwapChainPanelを使用 -->
        <SwapChainPanel x:Name="Viewport3D"
                        Background="Transparent">
        </SwapChainPanel>

        <!-- Loading indicator -->
        <Border x:Name="LoadingIndicator"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Background="#80000000"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="24"
                CornerRadius="8">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock Text="読み込み中..." Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Error message -->
        <Border x:Name="ErrorIndicator"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Background="#CC000000"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="24"
                CornerRadius="8"
                MaxWidth="400">
            <StackPanel Spacing="8">
                <TextBlock Text="エラー" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                          Foreground="White" 
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

