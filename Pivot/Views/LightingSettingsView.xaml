<UserControl
    x:Class="Pivot.Views.LightingSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Spacing="8" Padding="12" MinWidth="280">
        
            <!-- Preset Selector -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PresetComboBox" 
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select Preset"
                          SelectionChanged="PresetComboBox_SelectionChanged"/>
                <Button x:Name="SavePresetButton" Grid.Column="1" Margin="4,0,0,0"
                        ToolTipService.ToolTip="Save current as preset"
                        Click="SavePresetButton_Click">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE105;" FontSize="14"/>
                </Button>
            </Grid>
        
            <!-- Key Light Section -->
            <Expander Header="Key Light" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="4">
                    <!-- Intensity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensity" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="KeyIntensitySlider" Grid.Column="1" 
                                Minimum="0" Maximum="10" StepFrequency="0.1" Value="1.0"
                                ValueChanged="KeyIntensitySlider_ValueChanged"/>
                        <TextBlock x:Name="KeyIntensityValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="1.00"/>
                    </Grid>
                    
                    <!-- Color -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" VerticalAlignment="Top" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ColorPicker x:Name="KeyColorPicker" Grid.Column="1"
                                     ColorSpectrumShape="Box" IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                     MinWidth="160" MaxWidth="180"
                                     ColorChanged="KeyColorPicker_ColorChanged"/>
                    </Grid>
                    
                    <!-- Direction -->
                    <TextBlock Text="Direction" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yaw" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="YawSlider" Grid.Column="1" 
                                Minimum="-3.14159" Maximum="3.14159" StepFrequency="0.05" Value="0.3"
                                ValueChanged="YawSlider_ValueChanged"/>
                        <TextBlock x:Name="YawValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="0.30"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pitch" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="PitchSlider" Grid.Column="1" 
                                Minimum="0.1" Maximum="3.04159" StepFrequency="0.05" Value="1.0"
                                ValueChanged="PitchSlider_ValueChanged"/>
                        <TextBlock x:Name="PitchValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="1.00"/>
                    </Grid>
                </StackPanel>
            </Expander>
            
            <!-- Ambient Light Section -->
            <Expander Header="Ambient Light" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensity" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="AmbientIntensitySlider" Grid.Column="1" 
                                Minimum="0" Maximum="2" StepFrequency="0.05" Value="0.1"
                                ValueChanged="AmbientIntensitySlider_ValueChanged"/>
                        <TextBlock x:Name="AmbientIntensityValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="0.10"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" VerticalAlignment="Top" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ColorPicker x:Name="AmbientColorPicker" Grid.Column="1"
                                     ColorSpectrumShape="Box" IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                     MinWidth="160" MaxWidth="180"
                                     ColorChanged="AmbientColorPicker_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </Expander>
            
            <!-- Rim Light Section -->
            <Expander Header="Rim Light" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensity" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="RimIntensitySlider" Grid.Column="1" 
                                Minimum="0" Maximum="3" StepFrequency="0.05" Value="0.3"
                                ValueChanged="RimIntensitySlider_ValueChanged"/>
                        <TextBlock x:Name="RimIntensityValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="0.30"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" VerticalAlignment="Top" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ColorPicker x:Name="RimColorPicker" Grid.Column="1"
                                     ColorSpectrumShape="Box" IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                     MinWidth="160" MaxWidth="180"
                                     ColorChanged="RimColorPicker_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </Expander>
            
            <!-- Back Light Section -->
            <Expander Header="Back Light" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensity" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="BackIntensitySlider" Grid.Column="1" 
                                Minimum="0" Maximum="3" StepFrequency="0.05" Value="0.2"
                                ValueChanged="BackIntensitySlider_ValueChanged"/>
                        <TextBlock x:Name="BackIntensityValueText" Grid.Column="2" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="0.20"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" VerticalAlignment="Top" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ColorPicker x:Name="BackColorPicker" Grid.Column="1"
                                     ColorSpectrumShape="Box" IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                     MinWidth="160" MaxWidth="180"
                                     ColorChanged="BackColorPicker_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </Expander>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
