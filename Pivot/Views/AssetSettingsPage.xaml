<Page
    x:Class="Pivot.Views.AssetSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:viewmodels="using:Pivot.ViewModels"
    xmlns:converters="using:Pivot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="AssetSettingsRoot"
    x:DataType="viewmodels:AssetSettingsViewModel">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Pivot>
            <PivotItem Header="Viewport">
                <Grid ColumnSpacing="24" Padding="12,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="350"/>
                        <ColumnDefinition Width="*" MaxWidth="300"/>
                        <ColumnDefinition Width="*" MaxWidth="300"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Column 1: Current Settings (Camera, Grid, Display, Background) -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24">
                            <TextBlock Text="Current Settings" FontSize="18" FontWeight="SemiBold"/>
                            
                            <!-- Camera Section -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="Camera" FontSize="14" FontWeight="SemiBold"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Navigation" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="GesturePresetComboBox" Grid.Column="1"
                                              MinWidth="120" 
                                              SelectedIndex="{x:Bind ViewModel.SelectedGestureIndex, Mode=TwoWay}">
                                        <ComboBoxItem Tag="Maya" Content="Maya"/>
                                        <ComboBoxItem Tag="Houdini" Content="Houdini"/>
                                        <ComboBoxItem Tag="Blender" Content="Blender"/>
                                    </ComboBox>
                                </Grid>
                                
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                        CornerRadius="4" Padding="8">
                                    <Grid ColumnSpacing="12" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rotate" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.RotateGesture, Mode=OneWay}" FontSize="11"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pan" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PanGesture, Mode=OneWay}" FontSize="11"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Zoom" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ZoomGesture, Mode=OneWay}" FontSize="11"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Scroll" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Zoom" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            
                            <!-- Display Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Display" FontSize="14" FontWeight="SemiBold"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis Gizmo" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowAxisGizmoToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowAxisGizmo, Mode=TwoWay}"/>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Backface Cull" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="BackfaceCullingToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.BackfaceCulling, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Background Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Background" FontSize="14" FontWeight="SemiBold"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Color Mode" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="120"
                                              SelectedIndex="{x:Bind ViewModel.SelectedBackgroundModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Tag="Custom" Content="Custom"/>
                                        <ComboBoxItem Tag="MatchTheme" Content="Match Theme"/>
                                    </ComboBox>
                                </Grid>
                                
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.BackgroundColorPanelVisibility, Mode=OneWay}">
                                    <ColorPicker 
                                                 ColorSpectrumShape="Box" 
                                                 IsAlphaEnabled="False"
                                                 IsMoreButtonVisible="False"
                                                 IsColorSliderVisible="False"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True"
                                                 MinWidth="180" MaxWidth="200"
                                                 Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Wireframe Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Wireframe" FontSize="14" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Color" VerticalAlignment="Center" FontSize="12"/>
                                    <ColorPicker Grid.Column="1"
                                                 ColorSpectrumShape="Box" 
                                                 IsAlphaEnabled="False"
                                                 IsMoreButtonVisible="False"
                                                 IsColorSliderVisible="False"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True"
                                                 MinWidth="180" MaxWidth="200"
                                                 Color="{x:Bind ViewModel.WireframeColor, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Model Info Section -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Model Info" FontSize="14" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Polygons" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowPolygonCountToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowPolygonCount, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vertices" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowVertexCountToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowVertexCount, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UV Sets" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowUVSetCountToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowUVSetCount, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Materials" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowMaterialCountToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowMaterialCount, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bounds" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowBoundingBoxToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowBoundingBox, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Viewport Stats Section -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Viewport Stats" FontSize="14" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FPS" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowFPSToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowFPS, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Resolution" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowResolutionToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowResolution, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Viewport Size" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowViewportSizeToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowViewportSize, Mode=TwoWay}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Camera Info" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowCameraInfoToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowCameraInfo, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Grid Floor Section -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Grid" FontSize="14" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Show Grid" VerticalAlignment="Center" FontSize="12"/>
                                    <ToggleSwitch x:Name="ShowGridToggle" Grid.Column="1" 
                                                 IsOn="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Column 2: Material Presets -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Material Presets" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage PBR material presets" FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <ListView x:Name="MaterialPresetsList" 
                                      SelectionMode="Single"
                                      MaxHeight="400"
                                      SelectionChanged="MaterialPresetsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Background="Transparent" Padding="4"
                                                    Click="DeleteMaterialPreset_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddMaterialPresetButton" Content="Add Preset" Click="AddMaterialPreset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Column 3: Lighting Presets -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Lighting Presets" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage lighting presets" FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <ListView x:Name="LightingPresetsList" 
                                      SelectionMode="Single"
                                      MaxHeight="400"
                                      SelectionChanged="LightingPresetsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Background="Transparent" Padding="4"
                                                    Click="DeleteLightingPreset_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddLightingPresetButton" Content="Add Preset" Click="AddLightingPreset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
