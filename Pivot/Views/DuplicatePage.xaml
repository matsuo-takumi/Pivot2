<Page
    x:Class="Pivot.Views.DuplicatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pivot.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16" Padding="16">
            <Button Command="{x:Bind ViewModel.ScanCommand}" Content="Scan for Duplicates"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                    <StackPanel Spacing="8" Padding="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource SurfaceStrokeColorDefault}">
                        <TextBlock Text="Duplicate Group" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        
                        <GridView ItemsSource="{x:Bind Assets}" SelectionMode="Single" 
                                  SelectedItem="{x:Bind SelectedToKeep, Mode=TwoWay}">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateAssetItem">
                                    <Grid Width="150" Height="150" Margin="4">
                                        <Image Source="{x:Bind ThumbnailPath}"/>
                                        <Border Background="#AA000000" VerticalAlignment="Bottom" Padding="4">
                                            <TextBlock Text="{x:Bind FileName}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        
                        <Button Command="{x:Bind ResolveCommand}" Content="Keep Selected &amp; Delete Others"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
