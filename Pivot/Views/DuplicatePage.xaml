<Page
    x:Class="Pivot.Views.DuplicatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pivot.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- specific header -->
        <StackPanel Grid.Row="0" Spacing="12" Padding="24">
            <TextBlock Text="Duplicate Management" Style="{StaticResource TitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Scan for Exact Duplicates" Command="{x:Bind ViewModel.ScanCommand}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="8" Padding="12" CornerRadius="8">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Duplicate Group" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <Button Content="Resolve (Keep Selected)" Command="{x:Bind ResolveCommand}"/>
                            </StackPanel>
                            
                            <GridView ItemsSource="{x:Bind Assets}" SelectionMode="Single"
                                      SelectedItem="{x:Bind SelectedToKeep, Mode=TwoWay}">
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="150">
                                            <Image Source="{Binding ThumbnailPath}" Height="150" Stretch="UniformToFill"/>
                                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FileSize}" Opacity="0.6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
