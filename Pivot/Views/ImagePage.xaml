<Page
    x:Class="Pivot.Views.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:models="using:Pivot.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Pivot.Converters"
    xmlns:controls="using:Pivot.Controls"
    xmlns:vm="using:Pivot.ViewModels"
    mc:Ignorable="d"
    x:Name="ImagePageRoot"
    Background="Transparent">

    <Page.Resources>
        <!-- NavigationViewのコンテンツ領域を透明にするリソース -->
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
        
        <!-- Browser item context menu -->
        <MenuFlyout x:Key="BrowserItemContextMenu">
            <MenuFlyoutItem x:Name="OpenDirectoryMenuItem" Text="Open Folder" Click="OpenDirectory_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Padding="0,12,12,12">
        <!-- Folder Navigation with Content -->
        <NavigationView x:Name="FolderNavigationView" 
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        SelectionChanged="FolderNavigationView_SelectionChanged"
                        PaneTitle="フォルダー"
                        Background="Transparent">
            <NavigationView.PaneFooter>
                <StackPanel Spacing="0" Margin="0,8,0,12">
                    <!-- Show All Button -->
                    <Button x:Name="ShowAllButton"
                            Click="ShowAllButton_Click"
                            Background="Transparent" 
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="すべて表示" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Tags (Placeholder) -->
                    <Button IsEnabled="False"
                            Background="Transparent" 
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Tags (Coming Soon)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>


            <!-- Main Content -->
            <!-- Main Content -->
            <Grid>
                <!-- Normal Mode -->
                <Grid Visibility="{x:Bind ViewModel.IsDuplicateMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <!-- UnifiedBrowserControl with filtering and virtualized display -->
                    <controls:UnifiedBrowserControl x:Name="BrowserControl"
                                                    ItemClicked="BrowserControl_ItemClicked"
                                                    ItemDoubleClicked="BrowserControl_ItemDoubleClicked"
                                                    ItemRightTapped="BrowserControl_ItemRightTapped"/>
                    
                    <!-- Scan Duplicates Button -->
                    <Button Command="{x:Bind ViewModel.EnterDuplicateModeCommand}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="32" Padding="12,8"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="20"
                            Shadow="{StaticResource SharedShadow}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets"/> 
                            <TextBlock Text="Find Duplicates"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Duplicate Mode -->
                <Grid Visibility="{x:Bind ViewModel.IsDuplicateMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Command="{x:Bind ViewModel.ExitDuplicateModeCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8">
                                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <TextBlock Text="Duplicate Management" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="48,0,0,0">
                            <Button Content="Re-Scan" Command="{x:Bind ViewModel.EnterDuplicateModeCommand}"/>
                            <TextBlock Text="{x:Bind ViewModel.DuplicateStatusMessage, Mode=OneWay}" VerticalAlignment="Center"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanningDuplicates, Mode=OneWay}" 
                                         Visibility="{x:Bind ViewModel.IsScanningDuplicates, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                         Width="20" Height="20"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Content -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,16" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Duplicate Group" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                            <Button Grid.Column="1" Content="Resolve (Keep Selected)" Command="{x:Bind ResolveCommand}" Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>
                                        
                                        <GridView ItemsSource="{x:Bind Assets}" SelectionMode="Single"
                                                  SelectedItem="{x:Bind SelectedToKeep, Mode=TwoWay}">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:AssetEntity">
                                                    <Grid Width="160" Margin="0,0,12,12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Image Source="{x:Bind DisplayImageSource}" Height="120" Stretch="UniformToFill"/>
                                                        <StackPanel Grid.Row="1" Padding="0,8,0,0">
                                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind FileSize}" Opacity="0.6" FontSize="11"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                
                <!-- 画像プレビューオーバーレイ -->
                <controls:ImagePreviewControl x:Name="PreviewControl" Grid.RowSpan="2"/>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
