<Page
    x:Class="Pivot.Views.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:models="using:Pivot.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Pivot.Converters"
    xmlns:controls="using:Pivot.Controls"
    mc:Ignorable="d"
    x:Name="ImagePageRoot"
    Background="Transparent">

    <Page.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BitmapImageDecodeConverter x:Key="BitmapDecode"/>
        <conv:CachedBitmapImageConverter x:Key="CachedBitmapDecode"/>
        <conv:KindToVisibilityConverter x:Key="KindToVisibility"/>
        <conv:SelectionToBorderBrushConverter x:Key="SelectionToBorderBrushConverter"/>
        <conv:SelectionToBorderThicknessConverter x:Key="SelectionToBorderThicknessConverter"/>
        <conv:SelectionToBackgroundConverter x:Key="SelectionToBackgroundConverter"/>
        <conv:SelectionToPaddingConverter x:Key="SelectionToPaddingConverter"/>
        <conv:DateTimeFormatConverter x:Key="DateTimeConverter"/>

        <DataTemplate x:Key="MasonryItemTemplate" x:DataType="models:TemplateItem">
            <Border BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionToBorderBrushConverter}}" 
                    BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionToBorderThicknessConverter}}" 
                    CornerRadius="6" 
                    Padding="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionToPaddingConverter}}" 
                    Margin="4" 
                    Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectionToBackgroundConverter}}"
                    CanDrag="True"
                    PointerPressed="ImageItem_PointerPressed"
                    PointerMoved="ImageItem_PointerMoved"
                    PointerReleased="ImageItem_PointerReleased"
                    DragStarting="ImageItem_DragStarting"
                    DoubleTapped="ImageItem_DoubleTapped"
                    RightTapped="ImageItem_RightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Phase 0: Placeholder -->
                    <Grid Grid.Row="0" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" x:Phase="0" Tag="{x:Bind}"/>
                    
                    <!-- Phase 1: Image -->
                    <Image Grid.Row="0" Stretch="Uniform" Source="{x:Bind ThumbnailPath, Converter={StaticResource CachedBitmapDecode}, ConverterParameter=300}" x:Phase="1"/>
                    
                    <!-- Text Footer -->
                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0,12,12,12">
        <!-- Folder Navigation with Content -->
        <NavigationView x:Name="FolderNavigationView" 
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        SelectionChanged="FolderNavigationView_SelectionChanged"
                        PaneTitle="フォルダー">
            <NavigationView.PaneFooter>
                <StackPanel Spacing="0" Margin="0,8,0,12">
                    <!-- Tags (Placeholder) -->
                    <Button IsEnabled="False"
                            Background="Transparent" 
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Tags (Coming Soon)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>


            <!-- Main Content -->
            <Grid>
                <!-- UnifiedBrowserControl with filtering and virtualized display -->
                <controls:UnifiedBrowserControl x:Name="BrowserControl"
                                                ItemClicked="BrowserControl_ItemClicked"
                                                ItemDoubleClicked="BrowserControl_ItemDoubleClicked"
                                                ItemRightTapped="BrowserControl_ItemRightTapped"/>
                
                <!-- 画像プレビューオーバーレイ -->
                <controls:ImagePreviewControl x:Name="PreviewControl" Grid.RowSpan="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
