<Page
    x:Class="Pivot.Views.ColorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Pivot.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:flyout="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:codevm="using:Pivot.CodeModule.ViewModels"
    xmlns:converters="using:Pivot.Converters">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BooleanToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:DoubleFormatConverter x:Key="DoubleFormatConverter" />
        <converters:OpacityToPercentConverter x:Key="OpacityToPercentConverter" />
        <converters:BooleanNegationConverter x:Key="BoolInverter"/>
    </Page.Resources>

    <Grid Padding="20">
        <muxc:Pivot>
            <muxc:PivotItem Header="Text">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Text Color Roles" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button
                                Content="Reset to Default"
                                Click="ResetToDefaultButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="Customize the colors used for each semantic text role that responds to overlay lightness." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>

                        <!-- Enable Text Color Customization Toggle -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <ToggleSwitch
                                    Header="Enable Text Color Customization"
                                    IsOn="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=TwoWay}"
                                    OffContent="Use default theme colors"
                                    OnContent="Customize text colors" />
                                <TextBlock 
                                    Text="When enabled, you can customize individual text color roles. When disabled, the app uses default theme colors that automatically adapt to light/dark mode."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    FontSize="12"
                                    Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Preset Section -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Opacity="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                    <Button
                                        Content="Save Current as Preset"
                                        Click="SavePresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                </StackPanel>
                                
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.PresetViewModel.Presets}"
                                    SelectionMode="Single"
                                    SelectedItem="{x:Bind ViewModel.PresetViewModel.SelectedPreset, Mode=TwoWay}"
                                    MaxHeight="200"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    IsItemClickEnabled="True"
                                    ItemClick="PresetItem_Click"
                                    IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Foreground="{ThemeResource AppTextCaptionBrush}" 
                                                                   FontSize="12">
                                                            <Run Text="Updated: " />
                                                            <Run Text="{Binding UpdatedAt, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter='yyyy-MM-dd HH:mm'}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="Delete"
                                                        Click="DeletePresetButton_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Padding="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.PresetViewModel.SelectedPreset, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button
                                        Content="Apply Selected"
                                        Click="ApplySelectedPresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                    <Button
                                        Content="Delete Selected"
                                        Click="DeleteSelectedPresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Individual Text Color Role Settings -->
                        <StackPanel Spacing="10"
                                    Opacity="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <TextBlock Text="Text Color Roles" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Manually configure each text color role individually." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.TextColorSettings.Entries}"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                BorderThickness="0"
                                Background="Transparent"
                                ScrollViewer.VerticalScrollMode="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:TextColorSettingViewModel">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="16">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="Hex value (examples: #000000, #FFFFFF)" Foreground="{ThemeResource AppTextDimBrush}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                                    <Button x:Name="ColorSwatchButton" Width="32" Height="32" Background="Transparent" BorderThickness="0" Padding="0" Click="ColorSwatchButton_Click" Tag="{x:Bind}">
                                                        <Border Width="32" Height="32" CornerRadius="4" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{x:Bind PreviewBrush}" />
                                                    </Button>
                                                    <TextBox Width="100" Height="30" MinHeight="30" TextAlignment="Left" VerticalContentAlignment="Center" Text="{x:Bind HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </muxc:PivotItem>

            <muxc:PivotItem Header="Code">
                <Grid ColumnSpacing="24" Padding="12,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="600"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24">
                            <TextBlock Text="Code Editor Colors" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Customize the appearance of the code editor elements." 
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="14" Margin="0,-16,0,0"/>

                            <ListView ItemsSource="{x:Bind CodeViewModel.Colors, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="codevm:CodeColorSettingViewModel">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="16">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                                                    <!-- Reset Button -->
                                                    <Button Width="32" Height="32" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Command="{x:Bind ResetToDefaultCommand}"
                                                            Visibility="{x:Bind IsCustom, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Reset to Default (Theme)">
                                                        <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                                    </Button>

                                                    <!-- Color Preview Button -->
                                                    <Button Width="36" Height="36" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Click="CodeColorSwatch_Click" Tag="{x:Bind}">
                                                        <Border Width="36" Height="36" CornerRadius="4" 
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                                                                Background="{x:Bind PreviewBrush, Mode=OneWay}" />
                                                    </Button>
                                                    
                                                    <!-- Hex Input -->
                                                    <TextBox Width="90" Height="32" 
                                                             Text="{x:Bind HexValue, Mode=OneWay}" 
                                                             IsReadOnly="True" 
                                                             VerticalAlignment="Center" TextAlignment="Center"
                                                             Style="{StaticResource DefaultTextBoxStyle}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2: Snippet Card Appearance (Background Mode) -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24">
                            <TextBlock Text="Snippet Card Background" FontSize="18" FontWeight="SemiBold"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Background Style" FontSize="14" FontWeight="SemiBold"/>
                                <RadioButtons>
                                    <RadioButton Content="Match Theme (Default)" 
                                                 IsChecked="{x:Bind CodeViewModel.IsCustomColor, Mode=OneWay, Converter={StaticResource BoolInverter}}"
                                                 Command="{x:Bind CodeViewModel.SetThemeModeCommand}"/>
                                    <RadioButton Content="Custom Color" 
                                                 IsChecked="{x:Bind CodeViewModel.IsCustomColor, Mode=OneWay}"
                                                 Command="{x:Bind CodeViewModel.SetCustomColorModeCommand}"/>
                                </RadioButtons>
                                
                                <StackPanel Visibility="{x:Bind CodeViewModel.IsCustomColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" 
                                            Spacing="8" 
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Custom Color" FontSize="12"/>
                                    <Grid Width="200" HorizontalAlignment="Left">
                                        <muxc:ColorPicker x:Name="CodeColorPickerControl"
                                                          ColorSpectrumShape="Box"
                                                          IsMoreButtonVisible="False"
                                                          IsColorSliderVisible="False"
                                                          IsColorChannelTextInputVisible="True"
                                                          IsHexInputVisible="True"
                                                          IsAlphaEnabled="False"
                                                          ColorChanged="CodeColorPicker_ColorChanged"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </muxc:PivotItem>
        </muxc:Pivot>
    </Grid>
</Page>
