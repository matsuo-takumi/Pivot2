<Page
    x:Class="Pivot.Views.ColorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20">
        <StackPanel Spacing="24">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Scratchpad Editor Color" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBox Width="160" PlaceholderText="#RRGGBB" Text="{x:Bind ViewModel.ScratchpadColor, Mode=TwoWay}" />
                        <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                        <Border Width="24" Height="24" CornerRadius="2" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{x:Bind ViewModel.ScratchpadPreview}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText}" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Enter a hex color code (e.g. #F0F0F0) to tint the Scratchpad editor background." TextWrapping="Wrap" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Text Color" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Overlay lightness automatically chooses the best text color for readability (high lightness → black, low → white)." TextWrapping="Wrap" Foreground="Gray"/>
                    <Border Height="72" CornerRadius="10" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="Overlay Text Preview" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.OverlayTextBrush}" FontSize="16"/>
                    </Border>
                    <TextBlock Text="Text color controls are coming soon; for now it follows the overlay lightness slider." Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>


