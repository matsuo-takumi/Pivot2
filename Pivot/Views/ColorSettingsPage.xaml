<Page
    x:Class="Pivot.Views.ColorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Pivot.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:flyout="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:converters="using:Pivot.Converters">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BooleanToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:DoubleFormatConverter x:Key="DoubleFormatConverter" />
        <converters:OpacityToPercentConverter x:Key="OpacityToPercentConverter" />
    </Page.Resources>

    <Grid Padding="20">
        <muxc:Pivot>
            <muxc:PivotItem Header="Text">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Text Color Roles" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button
                                Content="Reset to Default"
                                Click="ResetToDefaultButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="Customize the colors used for each semantic text role that responds to overlay lightness." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>

                        <!-- Enable Text Color Customization Toggle -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <ToggleSwitch
                                    Header="Enable Text Color Customization"
                                    IsOn="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=TwoWay}"
                                    OffContent="Use default theme colors"
                                    OnContent="Customize text colors" />
                                <TextBlock 
                                    Text="When enabled, you can customize individual text color roles. When disabled, the app uses default theme colors that automatically adapt to light/dark mode."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    FontSize="12"
                                    Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Preset Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Opacity="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                    <Button
                                        Content="Save Current as Preset"
                                        Click="SavePresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                </StackPanel>
                                
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.PresetViewModel.Presets}"
                                    SelectionMode="Single"
                                    SelectedItem="{x:Bind ViewModel.PresetViewModel.SelectedPreset, Mode=TwoWay}"
                                    MaxHeight="200"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    IsItemClickEnabled="True"
                                    ItemClick="PresetItem_Click"
                                    IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Foreground="{ThemeResource AppTextCaptionBrush}" 
                                                                   FontSize="12">
                                                            <Run Text="Updated: " />
                                                            <Run Text="{Binding UpdatedAt, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter='yyyy-MM-dd HH:mm'}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="Delete"
                                                        Click="DeletePresetButton_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Padding="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.PresetViewModel.SelectedPreset, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button
                                        Content="Apply Selected"
                                        Click="ApplySelectedPresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                    <Button
                                        Content="Delete Selected"
                                        Click="DeleteSelectedPresetButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="12,8"
                                        IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Individual Text Color Role Settings -->
                        <StackPanel Spacing="10"
                                    Opacity="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <TextBlock Text="Text Color Roles" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Manually configure each text color role individually." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.TextColorSettings.Entries}"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                BorderThickness="0"
                                Background="Transparent"
                                ScrollViewer.VerticalScrollMode="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                IsEnabled="{x:Bind ViewModel.IsTextColorCustomizationEnabled, Mode=OneWay}"
                                ContainerContentChanging="TextColorEntryListView_ContainerContentChanging">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:TextColorSettingViewModel">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="16">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="Hex value (examples: #000000, #FFFFFF)" Foreground="{ThemeResource AppTextDimBrush}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                                    <Button x:Name="ColorSwatchButton" Width="32" Height="32" Background="Transparent" BorderThickness="0" Padding="0" Click="ColorSwatchButton_Click" Tag="{x:Bind}">
                                                        <Border Width="32" Height="32" CornerRadius="4" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{x:Bind PreviewBrush}" />
                                                    </Button>
                                                    <TextBox Width="100" Height="30" MinHeight="30" TextAlignment="Left" VerticalContentAlignment="Center" Text="{x:Bind HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </muxc:PivotItem>

            <muxc:PivotItem Header="Selector">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Image Selection Highlight" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Customize the appearance of selected image items in the Image page." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>

                        <!-- Select Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Select" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Configure the border appearance for selected image items." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12"/>

                                <!-- Color -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Color" FontWeight="SemiBold" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Width="48" Height="48" Background="Transparent" BorderThickness="0" Padding="0" Click="ImageSelectionColorButton_Click">
                                            <Border Width="48" Height="48" CornerRadius="6" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{x:Bind ViewModel.ImageSelectionColor, Converter={StaticResource HexToColorConverter}}" />
                                                </Border.Background>
                                            </Border>
                                            <flyout:FlyoutBase.AttachedFlyout>
                                                <Flyout Placement="Bottom">
                                                    <muxc:ColorPicker
                                                        x:Name="ImageSelectionColorPicker"
                                                        Color="{x:Bind ViewModel.ImageSelectionColor, Converter={StaticResource HexToColorConverter}}"
                                                        ColorChanged="ImageSelectionColorPicker_ColorChanged"
                                                        ColorSpectrumShape="Ring"
                                                        IsMoreButtonVisible="False"
                                                        IsColorSliderVisible="True"
                                                        IsColorChannelTextInputVisible="False"
                                                        IsHexInputVisible="True"
                                                        IsAlphaEnabled="False"
                                                        IsAlphaSliderVisible="False"
                                                        IsAlphaTextInputVisible="False" />
                                                </Flyout>
                                            </flyout:FlyoutBase.AttachedFlyout>
                                        </Button>
                                        <TextBox Width="120" Height="32" MinHeight="32" TextAlignment="Left" VerticalContentAlignment="Center" 
                                                 Text="{x:Bind ViewModel.ImageSelectionColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="#0078D4" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Opacity -->
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Opacity" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock FontSize="14" 
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="40"
                                                   TextAlignment="Right">
                                            <Run Text="{x:Bind ViewModel.ImageSelectionOpacity, Mode=OneWay, Converter={StaticResource OpacityToPercentConverter}}" />
                                            <Run Text="%" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="1" 
                                            Value="{x:Bind ViewModel.ImageSelectionOpacity, Mode=TwoWay}"
                                            TickFrequency="0.1"
                                            TickPlacement="BottomRight"
                                            StepFrequency="0.01" />
                                    <TextBlock Text="Adjust the transparency of the selection border (0 = fully transparent, 100 = fully opaque)." 
                                               TextWrapping="Wrap" 
                                               Foreground="{ThemeResource AppTextCaptionBrush}" 
                                               FontSize="11" />
                                </StackPanel>

                                <!-- Border Thickness -->
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Border Thickness" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ImageSelectionBorderThickness, Mode=OneWay}" 
                                                   FontSize="14" 
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="40"
                                                   TextAlignment="Right" />
                                        <TextBlock Text="px" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="10" 
                                            Value="{x:Bind ViewModel.ImageSelectionBorderThickness, Mode=TwoWay}"
                                            TickFrequency="1"
                                            TickPlacement="BottomRight"
                                            StepFrequency="0.5" />
                                    <TextBlock Text="Adjust the thickness of the selection border." 
                                               TextWrapping="Wrap" 
                                               Foreground="{ThemeResource AppTextCaptionBrush}" 
                                               FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </muxc:PivotItem>
        </muxc:Pivot>
    </Grid>
</Page>


