<Page
    x:Class="Pivot.Views.ColorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Pivot.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:flyout="using:Microsoft.UI.Xaml.Controls.Primitives"
    x:DataType="viewmodels:ColorSettingsViewModel">

    <Grid Padding="20">
        <muxc:Pivot>
            <muxc:PivotItem Header="Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Scratchpad Editor Color" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox Width="160" PlaceholderText="#RRGGBB" Text="{x:Bind ViewModel.ScratchpadColor, Mode=TwoWay}" />
                                    <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                                    <Border Width="24" Height="24" CornerRadius="2" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{x:Bind ViewModel.ScratchpadPreview}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusText}" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Enter a hex color code (e.g. #F0F0F0) to tint the Scratchpad editor background." TextWrapping="Wrap" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Overlay Text Preview" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Overlay lightness determines whether text should be shown in a high- or low-contrast variant." TextWrapping="Wrap" Foreground="Gray"/>
                                <Border Height="72" CornerRadius="10" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <TextBlock Text="Overlay Text Preview" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.OverlayTextBrush}" FontSize="16"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </muxc:PivotItem>

            <muxc:PivotItem Header="Text">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Text Color Roles" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Customize the colors used for each semantic text role that responds to overlay lightness." TextWrapping="Wrap" Foreground="Gray"/>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.TextColorSettings.Entries}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.VerticalScrollMode="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TextColorSettingViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="Hex value (examples: #000000, #FFFFFF)" Foreground="Gray" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Right" ColumnSpacing="8">
                                                <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="ColorSwatchButton_Click">
                                                    <Border Width="32" Height="32" CornerRadius="4" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{x:Bind PreviewBrush}" />
                                                    <flyout:FlyoutBase.AttachedFlyout>
                                                        <Flyout Placement="Bottom">
                                                            <muxc:ColorPicker
                                                                Color="{x:Bind SelectedColor, Mode=TwoWay}"
                                                                ColorSpectrumShape="Ring"
                                                                IsMoreButtonVisible="False"
                                                                IsColorSliderVisible="False"
                                                                IsColorChannelTextInputVisible="False"
                                                                IsHexInputVisible="False"
                                                                IsAlphaEnabled="False"
                                                                IsAlphaSliderVisible="False"
                                                                IsAlphaTextInputVisible="False" />
                                                        </Flyout>
                                                    </flyout:FlyoutBase.AttachedFlyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Width="120" Text="{x:Bind HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </muxc:PivotItem>
        </muxc:Pivot>
    </Grid>
</Page>


