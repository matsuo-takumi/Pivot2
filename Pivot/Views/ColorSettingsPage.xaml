<Page
    x:Class="Pivot.Views.ColorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="20">
        <Pivot>
            <PivotItem Header="Code">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scratchpad Editor Color" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBox Width="160" PlaceholderText="#RRGGBB" Text="{x:Bind ViewModel.ScratchpadColor, Mode=TwoWay}" />
                        <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                        <Border Width="24" Height="24" CornerRadius="2" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{x:Bind ViewModel.ScratchpadPreview}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText}" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Enter a hex color code (e.g. #F0F0F0) to tint the Scratchpad editor background." TextWrapping="Wrap" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </PivotItem>
            <PivotItem Header="Overlay">
                <StackPanel Padding="12" Spacing="12">
                    <TextBlock Text="Overlay Tint Color" FontSize="18" FontWeight="SemiBold"/>
                    <controls:ColorPicker
                        ColorSpectrumShape="Box"
                        IsMoreButtonVisible="False"
                        IsColorSliderVisible="True"
                        IsColorChannelTextInputVisible="True"
                        IsHexInputVisible="True"
                        IsAlphaEnabled="False"
                        IsAlphaSliderVisible="True"
                        IsAlphaTextInputVisible="True"
                        Color="{x:Bind ViewModel.OverlayColor, Mode=TwoWay}" />
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveOverlayCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusText}" Foreground="Gray" Margin="0,8,0,0"/>
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>


