<Page
    x:Class="Pivot.Views.ModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Pivot.Converters"
    xmlns:ctrls="using:Pivot.Controls"
    xmlns:models="using:Pivot.Models"
    mc:Ignorable="d"
    x:Name="ModelPageRoot"
    Background="Transparent">

    <Page.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BitmapImageDecodeConverter x:Key="BitmapDecode"/>
        <conv:SelectionToBorderBrushConverter x:Key="SelectionToBorderBrushConverter"/>
        <conv:SelectionToBorderThicknessConverter x:Key="SelectionToBorderThicknessConverter"/>
        <conv:SelectionToBackgroundConverter x:Key="SelectionToBackgroundConverter"/>
        <conv:SelectionToPaddingConverter x:Key="SelectionToPaddingConverter"/>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#20E0F7FF" CornerRadius="6" Padding="8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Models" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <ctrls:TagFilterControl TabId="Model" Margin="0,0,8,0"/>
                        <Button Command="{Binding ToggleLayoutCommand}" ToolTipService.ToolTip="{Binding CurrentLayout}">
                            <FontIcon Glyph="&#xECA5;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#20E8F5E9" CornerRadius="6" Padding="6">
                <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid>
                        <ItemsRepeater x:Name="ItemsRepeaterMain" ItemsSource="{Binding DisplayedModels}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="220" MinItemHeight="170" MinRowSpacing="8" MinColumnSpacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:TemplateItem">
                                    <Border BorderBrush="{Binding IsSelected, Converter={StaticResource SelectionToBorderBrushConverter}}" 
                                            BorderThickness="{Binding IsSelected, Converter={StaticResource SelectionToBorderThicknessConverter}, ConverterParameter={Binding DataContext.SelectionBorderThickness, ElementName=ModelPageRoot}}" 
                                            CornerRadius="6" 
                                            Padding="{Binding IsSelected, Converter={StaticResource SelectionToPaddingConverter}, ConverterParameter={Binding DataContext.SelectionBorderThickness, ElementName=ModelPageRoot}}" 
                                            Margin="4" 
                                            Background="{Binding IsSelected, Converter={StaticResource SelectionToBackgroundConverter}}"
                                            CanDrag="True"
                                            PointerPressed="ModelItem_PointerPressed"
                                            DragStarting="ModelItem_DragStarting"
                                            DoubleTapped="ModelItem_DoubleTapped" 
                                            Tag="{Binding Path}"
                                            RightTapped="ModelItem_RightTapped">
                                        <Border.Transitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition/>
                                            </TransitionCollection>
                                        </Border.Transitions>
                                        <Grid>
                                            <Grid Visibility="{Binding DataContext.UseTextListMode, ElementName=ModelPageRoot, Converter={StaticResource BoolToVisibility}}" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="300"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="20" Foreground="{ThemeResource AppTextAccentBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource AppTextCaptionBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="12" Foreground="{ThemeResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="12" Foreground="{ThemeResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LastModified}" FontSize="12" Foreground="{ThemeResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <StackPanel Visibility="{Binding DataContext.ShowThumbnails, ElementName=ModelPageRoot, Converter={StaticResource BoolToVisibility}}" MaxWidth="200">
                                                <Grid Width="200" Height="120" Background="Transparent">
                                                    <Image Stretch="UniformToFill" Source="{Binding ThumbnailPath, Converter={StaticResource BitmapDecode}, ConverterParameter=300}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Stretch" MinHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsControl x:Name="MasonryColumnsControl" ItemsSource="{Binding MasonryColumns}" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TemplateItem">
                                                <Border BorderBrush="{Binding IsSelected, Converter={StaticResource SelectionToBorderBrushConverter}}" 
                                                        BorderThickness="{Binding IsSelected, Converter={StaticResource SelectionToBorderThicknessConverter}, ConverterParameter={Binding DataContext.SelectionBorderThickness, ElementName=ModelPageRoot}}" 
                                                        CornerRadius="6" 
                                                        Padding="{Binding IsSelected, Converter={StaticResource SelectionToPaddingConverter}, ConverterParameter={Binding DataContext.SelectionBorderThickness, ElementName=ModelPageRoot}}" 
                                                        Margin="4" 
                                                        Background="{Binding IsSelected, Converter={StaticResource SelectionToBackgroundConverter}}"
                                                        Width="{Binding DataContext.MasonryColumnWidth, ElementName=ModelPageRoot}"
                                                        CanDrag="True"
                                                        PointerPressed="ModelItem_PointerPressed"
                                                        DragStarting="ModelItem_DragStarting"
                                                        DoubleTapped="ModelItem_DoubleTapped" 
                                                        Tag="{Binding Path}"
                                                        RightTapped="ModelItem_RightTapped">
                                                    <Border.Transitions>
                                                        <TransitionCollection>
                                                            <EntranceThemeTransition/>
                                                        </TransitionCollection>
                                                    </Border.Transitions>
                                                    <StackPanel>
                                                        <Grid Background="Transparent">
                                                            <Image Stretch="Uniform" Source="{Binding ThumbnailPath, Converter={StaticResource BitmapDecode}, ConverterParameter=300}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#20F0F0F0" CornerRadius="6" Padding="0" Margin="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#30F0F0F0" CornerRadius="6,6,0,0" Padding="12,8,12,8">
                    <TextBlock Text="3D Viewer" FontSize="16" FontWeight="SemiBold"/>
                </Border>
                <ctrls:ModelViewerControl x:Name="ModelViewer"
                                         Grid.Row="1"
                                         ModelPath="{Binding SelectedModel.Path, Mode=OneWay}"
                                         ViewerBackground="Transparent"
                                         MinHeight="400"/>
            </Grid>
        </Border>
    </Grid>
</Page>

