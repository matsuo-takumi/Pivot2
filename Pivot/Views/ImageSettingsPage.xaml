<Page
    x:Class="Pivot.Views.ImageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:flyout="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:converters="using:Pivot.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="ImageSettingsRoot">

    <Page.Resources>
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:OpacityToPercentConverter x:Key="OpacityToPercentConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel Spacing="24">
            <TextBlock Text="Image Browser Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Configure the image browser and preview behavior." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}"/>

            <!-- Selection Section -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Selection Border" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="Configure the appearance of selected item borders." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12"/>

                    <!-- Color -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" MinWidth="120"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SelectionColorButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" Padding="0" Click="SelectionColorButton_Click">
                                <Border Width="40" Height="40" CornerRadius="6" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="SelectionColorBrush" Color="{x:Bind ViewModel.SelectionColor, Mode=OneWay, Converter={StaticResource HexToColorConverter}}" />
                                    </Border.Background>
                                </Border>
                                <flyout:FlyoutBase.AttachedFlyout>
                                    <Flyout Placement="Bottom">
                                        <muxc:ColorPicker
                                            x:Name="SelectionColorPicker"
                                            ColorChanged="SelectionColorPicker_ColorChanged"
                                            ColorSpectrumShape="Ring"
                                            IsMoreButtonVisible="False"
                                            IsColorSliderVisible="True"
                                            IsColorChannelTextInputVisible="False"
                                            IsHexInputVisible="True"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False" />
                                    </Flyout>
                                </flyout:FlyoutBase.AttachedFlyout>
                            </Button>
                            <TextBox Width="100" Height="32" MinHeight="32" TextAlignment="Left" VerticalContentAlignment="Center" 
                                     Text="{x:Bind ViewModel.SelectionColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="#0078D4" />
                        </StackPanel>
                    </Grid>

                    <!-- Opacity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="120">
                            <TextBlock Text="Opacity" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.SelectionOpacity, Mode=OneWay, Converter={StaticResource OpacityToPercentConverter}}" />
                                <Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" 
                                Value="{x:Bind ViewModel.SelectionOpacity, Mode=TwoWay}"
                                TickFrequency="0.1" StepFrequency="0.01" />
                    </Grid>

                    <!-- Border Thickness -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="120">
                            <TextBlock Text="Border Thickness" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.SelectionBorderThickness, Mode=OneWay}" />
                                <Run Text="px" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="0" Maximum="10" 
                                Value="{x:Bind ViewModel.SelectionBorderThickness, Mode=TwoWay}"
                                TickFrequency="1" StepFrequency="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Browser Section -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Browser Display" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="Adjust thumbnail size and loading settings." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12"/>

                    <!-- Thumbnail Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                            <TextBlock Text="Thumbnail Size" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.ThumbnailSize, Mode=OneWay}" />
                                <Run Text="px" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="80" Maximum="400" 
                                Value="{x:Bind ViewModel.ThumbnailSize, Mode=TwoWay}"
                                TickFrequency="40" StepFrequency="20" />
                    </Grid>

                    <!-- Decode Pixel Width -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                            <TextBlock Text="Decode Resolution" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.DecodePixelWidth, Mode=OneWay}" />
                                <Run Text="px" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="100" Maximum="600" 
                                Value="{x:Bind ViewModel.DecodePixelWidth, Mode=TwoWay}"
                                TickFrequency="100" StepFrequency="50" />
                    </Grid>
                    <TextBlock Text="Limits thumbnail decode resolution for memory efficiency. Higher values are sharper but use more memory." 
                               TextWrapping="Wrap" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="11" Margin="0,-8,0,0"/>

                    <!-- Page Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                            <TextBlock Text="Page Size" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.PageSize, Mode=OneWay}" />
                                <Run Text="items" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="100" Maximum="50000" 
                                Value="{x:Bind ViewModel.PageSize, Mode=TwoWay}"
                                TickFrequency="5000" StepFrequency="100" />
                    </Grid>
                    <TextBlock Text="Number of items to load at once. Since UI is virtualized, large values don't affect display performance." 
                               TextWrapping="Wrap" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="11" Margin="0,-8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Preview Section -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="Adjust image preview display settings." TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12"/>

                    <!-- Max Zoom -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                            <TextBlock Text="Max Zoom" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.MaxZoom, Mode=OneWay}" />
                                <Run Text="x" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="5" Maximum="100" 
                                Value="{x:Bind ViewModel.MaxZoom, Mode=TwoWay}"
                                TickFrequency="10" StepFrequency="5" />
                    </Grid>

                    <!-- Fixed Display Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                            <TextBlock Text="Initial Display Size" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.FixedDisplaySize, Mode=OneWay}" />
                                <Run Text="px" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="400" Maximum="2000" 
                                Value="{x:Bind ViewModel.FixedDisplaySize, Mode=TwoWay}"
                                TickFrequency="200" StepFrequency="100" />
                    </Grid>
                    <TextBlock Text="Initial fit size when previewing. Larger values display images bigger." 
                               TextWrapping="Wrap" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="11" Margin="0,-8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
