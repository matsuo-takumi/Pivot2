<Page
    x:Class="Pivot.Views.AssetPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:conv="using:Pivot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- フィルタヘッダー -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Asset Library" FontSize="24" FontWeight="Bold"/>
            
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Asset Type:" FontSize="14"/>
                    <ComboBox 
                        ItemsSource="{Binding AssetTypes}" 
                        SelectedItem="{Binding SelectedAssetType, Mode=TwoWay}"
                        PlaceholderText="All Types"
                        Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Category:" FontSize="14"/>
                    <ComboBox 
                        ItemsSource="{Binding Categories}" 
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        PlaceholderText="All Categories"
                        Width="200"/>
                </StackPanel>

                <Button 
                    Content="Reset Filters" 
                    Command="{Binding ResetFiltersCommand}"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,0"/>

                <!-- 表示モード切替 -->
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="View:" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="List" Command="{Binding SetDisplayModeCommand}" CommandParameter="List"/>
                        <Button Content="Grid" Command="{Binding SetDisplayModeCommand}" CommandParameter="Grid"/>
                    </StackPanel>
                </StackPanel>

                <!-- メタデータ表示切替 -->
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Metadata:" FontSize="14"/>
                    <ToggleSwitch IsOn="{Binding ShowMetadata, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock 
                Text="{Binding TotalCount}" 
                FontSize="12" 
                Foreground="#666666"/>
        </StackPanel>

        <!-- ロード中インジケーター（初回ロード） -->
        <ProgressRing 
            Grid.Row="1"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            Width="50" 
            Height="50"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>

        <!-- メインコンテンツ：モード切替（List / Grid） -->
        <Grid Grid.Row="1">
            <!-- List モード -->
            <ScrollViewer x:Name="ListScrollViewer"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}">
                <ItemsRepeater ItemsSource="{Binding Assets}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="20" Foreground="#0078D4" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="12" Foreground="#555555" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowMetadata, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="12" Foreground="#555555" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowMetadata, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding UpdatedAt}" FontSize="12" Foreground="#555555" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowMetadata, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TagsJson}" FontSize="12" Foreground="#777777" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowMetadata, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Grid モード -->
            <ScrollViewer x:Name="GridScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVisibility}}">
                <ItemsRepeater ItemsSource="{Binding Assets}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="220" MinItemHeight="160" MinRowSpacing="8" MinColumnSpacing="8"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- サムネイル/アイコン -->
                                    <FontIcon Glyph="&#xE7B3;" FontSize="28" Foreground="#0078D4"/>
                                    <!-- ファイル名 -->
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <!-- メタデータ（トグルで表示/非表示） -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="{Binding DataContext.ShowMetadata, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#555555"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="11" Foreground="#555555"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- 下部：ロード中インジケーター（追加ロード） -->
        <ProgressRing 
            Grid.Row="2"
            IsActive="{Binding IsLoadingMore}"
            Visibility="{Binding IsLoadingMore}"
            Width="30" 
            Height="30"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"/>
    </Grid>
</Page>
