<Page
    x:Class="Pivot.Views.AssetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Pivot.Controls"
    xmlns:models="using:Pivot.Engine.Models"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    x:Name="AssetPageRoot"
    Background="Transparent">

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Column: File List -->
        <Border Grid.Column="0" 
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                        CornerRadius="6,6,0,0" 
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3D Models" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileCountText" Grid.Column="1" Text="0 items" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- File List -->
                <ListView x:Name="FileListView"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="FileListView_SelectionChanged"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AssetEntity">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- File Name -->
                                <TextBlock Text="{x:Bind FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                
                                <!-- File Size -->
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind local:AssetPage.FormatFileSize(FileSize)}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        
        <!-- Draggable Splitter -->
        <sizers:GridSplitter Grid.Column="1"
                             ResizeBehavior="BasedOnAlignment"
                             ResizeDirection="Columns"/>
        
        <!-- Right Column: 3D Viewer (Full Width) -->
        <Border Grid.Column="2" 
                Background="#20F0F0F0" 
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="#30F0F0F0" 
                        CornerRadius="6,6,0,0" 
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3D Viewer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectedModelText" Grid.Column="1" 
                                   Text="" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                    </Grid>
                </Border>
                
                <!-- 3D Model Viewer -->
                <controls:ModelViewerControl x:Name="ModelViewer"
                                             Grid.Row="1"
                                             ModelPath="{Binding SelectedAsset.Path, Mode=OneWay}"
                                             ViewerBackground="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</Page>
