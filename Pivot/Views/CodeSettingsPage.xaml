<Page
    x:Class="Pivot.Views.CodeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20">
        <Pivot>
            <!-- Tags (Filters) Tab -->
            <PivotItem Header="Tags">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Code Filters (Tags)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Add Filter" Click="AddFilter_Click" Margin="12,0,0,0" />
                        <Button Content="Restore Defaults" Click="RestoreDefaults_Click" Margin="8,0,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer>
                            <ItemsControl x:Name="FiltersList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,0,0,8" Background="#10FFFFFF" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AllowedExtensionsString}" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ToggleSwitch IsOn="{Binding Visible}" Toggled="FilterVisible_Toggled" Tag="{Binding Id}" />
                                                    <Button Content="Edit" Click="EditFilter_Click" Tag="{Binding Id}" />
                                                    <Button Content="Delete" Click="DeleteFilter_Click" Tag="{Binding Id}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- Categories tab removed: categories are deprecated. -->

            <!-- Save/Export Tab -->
            <PivotItem Header="Save">
                <Grid Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Snippet Save Format" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Format:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SaveFormatCombo" Width="220" SelectionChanged="SaveFormatCombo_SelectionChanged">
                                <ComboBoxItem Content="JSON (.json)" Tag="Json" />
                                <ComboBoxItem Content="Markdown (.md)" Tag="Markdown" />
                            </ComboBox>
                        </StackPanel>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Output directory for saved snippets" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="OutputDirBox" Width="420" TextWrapping="NoWrap" />
                                    <Button Content="Browse..." Click="BrowseButton_Click" />
                                    <Button Content="Save" Click="SaveButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Foreground="Gray" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>

</Page>


