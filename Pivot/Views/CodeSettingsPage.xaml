<Page
    x:Class="Pivot.Views.CodeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views">

    <Grid Padding="20">
        <Pivot>
            <!-- Tags (Filters) Tab -->
            <PivotItem Header="Tags">
                <local:FilterSettingsView x:Name="FilterSettingsView" />
            </PivotItem>

            <!-- Categories tab removed: categories are deprecated. -->

            <!-- Save/Export Tab -->
            <PivotItem Header="Save">
                <Grid Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Snippet Save Format" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Format:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SaveFormatCombo" Width="220" SelectionChanged="SaveFormatCombo_SelectionChanged">
                                <ComboBoxItem Content="JSON (.json)" Tag="Json" />
                                <ComboBoxItem Content="Markdown (.md)" Tag="Markdown" />
                            </ComboBox>
                        </StackPanel>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Output directory for saved snippets" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="OutputDirBox" Width="420" TextWrapping="NoWrap" />
                                    <Button Content="Browse..." Click="BrowseButton_Click" />
                                    <Button Content="Save" Click="SaveButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppTextCaptionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>

</Page>


