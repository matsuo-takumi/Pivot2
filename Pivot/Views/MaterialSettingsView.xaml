<UserControl
    x:Class="Pivot.Views.MaterialSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
        <StackPanel Spacing="24">
            
            <!-- Material Preset Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Material Preset" FontSize="16" FontWeight="SemiBold"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Preset" VerticalAlignment="Center" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="PresetComboBox" Grid.Column="1" 
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              SelectionChanged="PresetComboBox_SelectionChanged"/>
                </Grid>
            </StackPanel>

            <!-- PBR Properties Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="PBR Properties" FontSize="16" FontWeight="SemiBold"/>
                
                <!-- Albedo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Albedo" VerticalAlignment="Center" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ColorPicker x:Name="AlbedoColorPicker" 
                                 Grid.Column="1"
                                 ColorSpectrumShape="Box"
                                 IsAlphaEnabled="False"
                                 IsMoreButtonVisible="False"
                                 IsColorSliderVisible="False"
                                 IsColorChannelTextInputVisible="False"
                                 IsHexInputVisible="True"
                                 MinWidth="180" MaxWidth="220"
                                 ColorChanged="AlbedoColorPicker_ColorChanged"/>
                </Grid>
                
                <!-- Metallic -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Metallic" VerticalAlignment="Center" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="MetallicSlider" Grid.Column="1" 
                            Minimum="0" Maximum="1" StepFrequency="0.01"
                            ValueChanged="MetallicSlider_ValueChanged"/>
                    <TextBlock x:Name="MetallicValueText" Grid.Column="2" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- Roughness -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Roughness" VerticalAlignment="Center" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="RoughnessSlider" Grid.Column="1" 
                            Minimum="0" Maximum="1" StepFrequency="0.01"
                            ValueChanged="RoughnessSlider_ValueChanged"/>
                    <TextBlock x:Name="RoughnessValueText" Grid.Column="2" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- Save Preset Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Custom Presets" FontSize="16" FontWeight="SemiBold"/>
                
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewPresetNameBox" PlaceholderText="New preset name..."/>
                    <Button x:Name="SavePresetButton" Grid.Column="1" Content="Save Preset"
                            Click="SavePresetButton_Click"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
