<Page
    x:Class="Pivot.Views.TemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="TemplatePageRoot"
    Background="Transparent">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: 表示モード切替（半透明の背景で強調） -->
        <Border Grid.Row="0" Background="#20E0F7FF" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Templates" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                    <Button Command="{Binding ToggleLayoutCommand}" ToolTipService.ToolTip="{Binding CurrentLayout}">
                        <FontIcon Glyph="&#xECA5;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 本体: グリッド表示（ImageItemにバインド） -->
        <Border Grid.Row="1" Background="#20E8F5E9" CornerRadius="6" Padding="6">
            <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <Grid>
                    <!-- Standard ItemsRepeater (Grid / List / Justified fallback) -->
                    <ItemsRepeater x:Name="ItemsRepeaterMain" ItemsSource="{Binding TestItems}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="220" MinItemHeight="160" MinRowSpacing="8" MinColumnSpacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0" CornerRadius="6" Padding="6" Margin="4" Background="#10FFFFFF">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition/>
                                        </TransitionCollection>
                                    </Border.Transitions>
                                    <StackPanel>
                                        <Grid Width="200" Height="120" Background="Transparent">
                                            <Image Stretch="Uniform" Source="{Binding ThumbnailPath}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Masonry columns: visible only when Masonry layout is selected -->
                    <ItemsControl x:Name="MasonryColumnsControl" ItemsSource="{Binding MasonryColumns}" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Each item here is an ObservableCollection<ImageItem> representing a column -->
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="0" CornerRadius="6" Padding="6" Margin="4" Background="#10FFFFFF" Width="{Binding DataContext.MasonryColumnWidth, ElementName=TemplatePageRoot}">
                                                <Border.Transitions>
                                                    <TransitionCollection>
                                                        <EntranceThemeTransition/>
                                                    </TransitionCollection>
                                                </Border.Transitions>
                                                <StackPanel>
                                                    <Grid Background="Transparent">
                                                        <Image Stretch="Uniform" Source="{Binding ThumbnailPath}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Justified rows: visible only when Justified layout is selected -->
                    <ItemsControl x:Name="JustifiedRowsControl" ItemsSource="{Binding JustifiedRows}" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Each item is a row (collection of JustifiedItem) -->
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="0" CornerRadius="6" Padding="6" Margin="4" Background="#10FFFFFF" Height="{Binding DataContext.JustifiedRowHeight, ElementName=TemplatePageRoot}" Width="{Binding Width}">
                                                <Border.Transitions>
                                                    <TransitionCollection>
                                                        <EntranceThemeTransition/>
                                                    </TransitionCollection>
                                                </Border.Transitions>
                                                <Grid Background="Transparent">
                                                    <Image Stretch="UniformToFill" Source="{Binding Source.ThumbnailPath}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
