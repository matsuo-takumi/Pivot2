<Page
    x:Class="Pivot.Views.DirectoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pivot.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    x:DataType="local:DirectoryPage"
    x:Name="DirectoryPageRoot">

    <!-- Grid for dynamic 4-column layout (wrapped in horizontal ScrollViewer) -->
    <ScrollViewer x:Name="DirectoriesScrollViewer" Padding="20" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
        
        <!-- Section 1: Asset Directories -->
        <Border Grid.Column="0" MinWidth="360"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,10,0">
            <StackPanel Spacing="12">
                <TextBlock Text="Asset Directories" 
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <!-- Add Button -->
                <Button Content="+" 
                        Command="{Binding SelectAssetDirectoryCommand}" 
                        Width="40" 
                        Height="40"
                        HorizontalAlignment="Left"
                        CornerRadius="4"
                        FontSize="18"
                        Padding="0"/>
                
                <!-- Directory List -->
                <ItemsControl ItemsSource="{Binding AssetDirectories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.OpenDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Folder"/>
                                </Button>
                                <TextBlock Text="{Binding}" 
                                           Grid.Column="1"
                                           VerticalAlignment="Center" 
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"/>
                                <Button Content="−" 
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.RemoveDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Grid.Column="2"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Section 2: Image Directories -->
        <Border Grid.Column="1" MinWidth="360"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="10,0,10,0">
            <StackPanel Spacing="12">
                <TextBlock Text="Image Directories" 
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <!-- Add Button -->
                <Button Content="+" 
                        Command="{Binding SelectImageDirectoryCommand}" 
                        Width="40" 
                        Height="40"
                        HorizontalAlignment="Left"
                        CornerRadius="4"
                        FontSize="18"
                        Padding="0"/>
                
                <!-- Directory List -->
                <ItemsControl ItemsSource="{Binding ImageDirectories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.OpenDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Folder"/>
                                </Button>
                                <TextBlock Text="{Binding}" 
                                           Grid.Column="1"
                                           VerticalAlignment="Center" 
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"/>
                                <Button Content="−" 
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.RemoveDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Grid.Column="2"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Section 3: Project Directories -->
        <Border Grid.Column="2" MinWidth="360" Margin="10,0,10,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                >
            <StackPanel Spacing="12">
                <TextBlock Text="Project Directories" 
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <!-- Add Button -->
                <Button Content="+" 
                        Command="{Binding SelectProjectDirectoryCommand}" 
                        Width="40" 
                        Height="40"
                        HorizontalAlignment="Left"
                        CornerRadius="4"
                        FontSize="18"
                        Padding="0"/>
                
                <!-- Directory List -->
                <ItemsControl ItemsSource="{Binding ProjectDirectories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.OpenDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Folder"/>
                                </Button>
                                <TextBlock Text="{Binding}" 
                                           Grid.Column="1"
                                           VerticalAlignment="Center" 
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"/>
                                <Button Content="−" 
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.RemoveDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Grid.Column="2"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        
        <!-- Section 4: Code Directories -->
        <Border Grid.Column="3" MinWidth="360"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="10,0,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="Code Directories" 
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <!-- Add Button -->
                <Button Content="+" 
                        Command="{Binding SelectCodeDirectoryCommand}" 
                        Width="40" 
                        Height="40"
                        HorizontalAlignment="Left"
                        CornerRadius="4"
                        FontSize="18"
                        Padding="0"/>
                
                <!-- Directory List -->
                <ItemsControl ItemsSource="{Binding CodeDirectories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.OpenDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Folder"/>
                                </Button>
                                <TextBlock Text="{Binding}" 
                                           Grid.Column="1"
                                           VerticalAlignment="Center" 
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"/>
                                <Button Content="−" 
                                        Command="{Binding ElementName=DirectoryPageRoot, Path=DataContext.RemoveDirectoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Grid.Column="2"
                                        Width="32" 
                                        Height="32"
                                        CornerRadius="4" 
                                        Padding="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
    
</Page>


