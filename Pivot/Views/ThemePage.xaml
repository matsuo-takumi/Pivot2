<UserControl
    x:Class="Pivot.Views.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pivot.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    x:DataType="viewmodels:ThemeViewModel">

    <Grid Padding="20">
        <StackPanel Spacing="20">
            <!-- Background Style Selection -->
            <StackPanel Spacing="10">
                <TextBlock Text="Background Style" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="None" 
                        Tag="None"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Mica" 
                        Tag="Mica"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Mica Alt" 
                        Tag="MicaAlt"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Acrylic" 
                        Tag="Acrylic"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Acrylic Thin" 
                        Tag="AcrylicThin"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                </StackPanel>
            </StackPanel>

            <!-- App Theme Selection -->
            <StackPanel Spacing="10">
                <TextBlock Text="App Theme" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Light" 
                        Tag="Light"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Dark" 
                        Tag="Dark"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Default" 
                        Tag="Default"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
