<UserControl
    x:Class="Pivot.Views.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pivot.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pivot.ViewModels"
    xmlns:converters="using:Pivot.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    x:DataType="viewmodels:ThemeViewModel">

    <UserControl.Resources>
        <converters:DoubleFormatConverter x:Key="DoubleFormatConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20">
            <StackPanel Spacing="20">
            <!-- Background Style Selection -->
            <StackPanel Spacing="10">
                <TextBlock Text="Background Style" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="None" 
                        Tag="None"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Mica" 
                        Tag="Mica"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Mica Alt" 
                        Tag="MicaAlt"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Acrylic" 
                        Tag="Acrylic"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Acrylic Thin" 
                        Tag="AcrylicThin"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Overlay"
                        Tag="Overlay"
                        Click="BackdropButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                </StackPanel>
            </StackPanel>

            <!-- App Theme Selection -->
            <StackPanel Spacing="10">
                <TextBlock Text="App Theme" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Light" 
                        Tag="Light"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Dark" 
                        Tag="Dark"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                    <Button Content="Default" 
                        Tag="Default"
                        Click="ThemeButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,8"/>
                </StackPanel>
                <TextBlock Text="Default mode uses time-based automatic switching (see below)" 
                           Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12"/>
            </StackPanel>

            <!-- Time-Based Theme Settings -->
            <StackPanel Spacing="10">
                <TextBlock Text="Time-Based Theme (Default Mode)" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="When App Theme is set to 'Default', the theme will automatically switch based on time of day." 
                                   TextWrapping="Wrap" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12"/>
                        
                        <!-- Light Start Hour -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                                <TextBlock Text="Light Mode Start" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{x:Bind ViewModel.LightStartHour, Mode=OneWay}"/>
                                    <Run Text=":00"/>
                                </TextBlock>
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="23" 
                                    Value="{x:Bind ViewModel.LightStartHour, Mode=TwoWay}"
                                    TickFrequency="1" StepFrequency="1" />
                        </Grid>
                        
                        <!-- Dark Start Hour -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="160">
                                <TextBlock Text="Dark Mode Start" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{x:Bind ViewModel.DarkStartHour, Mode=OneWay}"/>
                                    <Run Text=":00"/>
                                </TextBlock>
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="23" 
                                    Value="{x:Bind ViewModel.DarkStartHour, Mode=TwoWay}"
                                    TickFrequency="1" StepFrequency="1" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Overlay Tint Settings -->
            <StackPanel Spacing="14">
                <TextBlock Text="Overlay Tint" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontWeight="SemiBold"/>
                <Border Height="100" CornerRadius="10" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{x:Bind ViewModel.OverlayTint.AcrylicBrush}">
                        <TextBlock Text="Overlay Text" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.OverlayTint.TextBrush}" />
                    </Border>
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.StatusText}" Foreground="{ThemeResource AppTextCaptionBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Hue" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.Hue, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Hue: {0:F0}°'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="360" StepFrequency="1" Value="{x:Bind ViewModel.OverlayTint.Hue, Mode=TwoWay}" />

                        <TextBlock Text="Saturation" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.Saturation, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Saturation: {0:P0}'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.OverlayTint.Saturation, Mode=TwoWay}" />

                        <TextBlock Text="Lightness" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.Lightness, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Lightness: {0:P0}'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.OverlayTint.Lightness, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Tint Opacity" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.TintOpacity, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Opacity: {0:P0}'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.OverlayTint.TintOpacity, Mode=TwoWay}" />

                        <TextBlock Text="Luminosity Opacity" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.TintLuminosityOpacity, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Luminosity: {0:P0}'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.OverlayTint.TintLuminosityOpacity, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Transition Duration" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverlayTint.TintTransitionDurationMs, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='Duration: {0} ms'}" Foreground="{ThemeResource AppTextCaptionBrush}"/>
                        <Slider Minimum="0" Maximum="2000" StepFrequency="50" Value="{x:Bind ViewModel.OverlayTint.TintTransitionDurationMs, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
