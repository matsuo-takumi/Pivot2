<Page
    x:Class="Pivot.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="12">
        <StackPanel Spacing="8">
            <TextBlock Text="Export settings" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Output directory for exported code items:" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="OutputDirBox" Width="520"/>
                <Button x:Name="BrowseButton" Content="Browse" Click="BrowseButton_Click" />
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="Gray" />
        </StackPanel>
    </Grid>
</Page>


